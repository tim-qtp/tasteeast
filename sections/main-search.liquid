{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{% paginate search.results by 24 %}

<style>
/* 页面背景恢复正常 */
.template-search {
  background: transparent !important;
  padding: 0 !important;
}

/* 保留的唯一内容区域 */
.search-result-box {
  max-width: 720px;
  margin: 80px auto 140px;
  padding: 50px 40px;
  background: linear-gradient(180deg, #12344A 0%, #071624 100%);
  border-radius: 26px;
  text-align: center;
  color: #FFFFFF;
  box-shadow: 0 26px 70px rgba(0,0,0,0.45);
}

/* 图标 */
.search-result-box .template-search__empty-icon {
  font-size: 48px;
  display: block;
  margin-bottom: 22px;
}

/* 主文案 */
.search-result-box .template-search__empty-title {
  font-size: 26px;
  font-weight: 700;
  margin-bottom: 14px;
}

/* 副文案 */
.search-result-box .template-search__empty-text {
  font-size: 16px;
  opacity: 0.85;
  line-height: 1.6;
}

/* 如果有商品结果时不显示这个卡片 */
{% if search.results_count > 0 %}
.search-result-box {
  display: none !important;
}
{% endif %}
</style>

<div class="template-search">
  <div class="search-result-box">
      <span class="template-search__empty-icon">🔍</span>
      <div class="template-search__empty-title">
        No results for “{{ search.terms }}”
      </div>
      <p class="template-search__empty-text">
        No results found. Try another keyword.
      </p>
  </div>

  {%- if search.results.size > 0 -%}
    <div class="page-width" style="margin-top:80px;">
      <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
        {%- for item in search.results -%}
          <li class="grid__item">
            {%- case item.object_type -%}
              {%- when 'product' -%}
                {% render 'card-product', card_product: item %}
              {%- when 'article' -%}
                {% render 'article-card', article: item %}
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  {%- endif -%}
</div>

{% endpaginate %}
