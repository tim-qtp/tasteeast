{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
/* ===== 全局深色背景 ===== */
.template-search {
  background-color: #0B1C2D !important;
}

/* ===== 顶部标题样式 ===== */
.template-search__header h1 {
  color: #FFFFFF;
  text-align: center;
  font-size: 42px;
  font-weight: 700;
  margin-bottom: 32px;
}

/* ===== 搜索框样式 ===== */
.template-search__search .search__input {
  width: 100%;
  border: 2px solid #216D81;
  background: #FFFFFF;
  border-radius: 6px;
  color: #222;
  height: 56px;
  font-size: 18px;
  padding: 0 16px;
}

.template-search__search .search__input:focus {
  border-color: #2793A8;
  outline: none;
}

/* 隐藏 label 与搜索按钮 */
.template-search__search .field__label,
.template-search__search .search__button,
.template-search__search .reset__button {
  display: none !important;
}

/* ===== 结果数量文案 ===== */
.template-search__count {
  margin-top: 6px;
  font-size: 18px;
  text-align: center;
  color: #FFFFFF;
}

/* ===== 无结果容器 ===== */
.template-search__empty-box {
  max-width: 950px;
  margin: 0 auto 60px;
  padding: 48px 30px;
  background: #0F2A3B;
  border-radius: 12px;
  text-align: center;
  color: #FFFFFF;
}
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

{% paginate search.results by 24 %}
  <div class="template-search section-{{ section.id }}-padding">

    <!-- ========= Header & Search Form ========= -->
    <div class="template-search__header page-width">
      <h1 class="h2 center">{{ 'templates.search.title' | t }}</h1>
      <div class="template-search__search">
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search">
            <div class="field">
              <input
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.search' | t }}"
              >
              <input name="options[prefix]" type="hidden" value="last">
            </div>
          </form>
        </main-search>
      </div>
    </div>

    <!-- ========= 仅保留这一份结果显示区域 ========= -->
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="template-search__count">
          {{ search.results_count }} results for “{{ search.terms }}”
        </p>
      {%- else -%}
        <div class="template-search__empty-box">
          <span class="template-search__empty-icon">🔍</span>
          <div class="template-search__empty-title">
            No results for “{{ search.terms }}”
          </div>
          <p class="template-search__empty-text">
            No results found. Try another keyword.
          </p>
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- ========= 渲染商品结果区域（原样保留） ========= -->
    {%- if search.results.size > 0 -%}
      <div class="product-grid-container page-width">
        <ul class="grid product-grid grid--2-col-tablet-down grid--4-col-desktop" role="list">
          {%- for item in search.results -%}
            <li class="grid__item">
              {%- case item.object_type -%}
                {%- when 'product' -%}
                  {% render 'card-product', card_product: item %}
                {%- when 'article' -%}
                  {% render 'article-card', article: item %}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      </div>
    {%- endif -%}

  </div>
{% endpaginate %}
