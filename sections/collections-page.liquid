{{ 'section-collections-page.css' | asset_url | stylesheet_tag }}

<div class="collections-page page-width">
  <div class="collections-page__container">
    <!-- Left Side: Category Menu -->
    <aside class="collections-page__sidebar">
      {%- if section.settings.heading != blank -%}
        <h2 class="collections-page__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <nav class="collections-nav">
          <ul class="collections-nav__list">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'parent_category' -%}
                  <li class="collections-nav__item collections-nav__item--parent" {{ block.shopify_attributes }}>
                    <button 
                      class="collections-nav__link collections-nav__link--parent" 
                      type="button"
                      aria-expanded="false"
                      data-parent-toggle
                    >
                      {{ block.settings.title }}
                      <svg class="collections-nav__icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </button>
                    
                    {%- assign parent_id = block.id -%}
                    {%- assign has_children = false -%}
                    
                    {%- for child_block in section.blocks -%}
                      {%- if child_block.type == 'child_category' and child_block.settings.parent_id == parent_id -%}
                        {%- assign has_children = true -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    
                    {%- if has_children -%}
                      <ul class="collections-nav__sublist" data-parent-content>
                        {%- for child_block in section.blocks -%}
                          {%- if child_block.type == 'child_category' and child_block.settings.parent_id == parent_id -%}
                            <li class="collections-nav__item collections-nav__item--child" {{ child_block.shopify_attributes }}>
                              <a 
                                href="/collections/{{ child_block.settings.collection_handle }}" 
                                class="collections-nav__link collections-nav__link--child"
                              >
                                {{ child_block.settings.title }}
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </li>
                  
                {%- when 'single_category' -%}
                  <li class="collections-nav__item collections-nav__item--single" {{ block.shopify_attributes }}>
                    <a 
                      href="/collections/{{ block.settings.collection_handle }}" 
                      class="collections-nav__link"
                    >
                      {{ block.settings.title }}
                    </a>
                  </li>
              {%- endcase -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </aside>

    <!-- Right Side: Featured Collections -->
    <div class="collections-page__featured">
      {%- assign featured_blocks = section.blocks | where: 'type', 'featured_collection' -%}
      
      {%- if featured_blocks.size > 0 -%}
        <div class="featured-collections">
          {%- for block in featured_blocks -%}
            <a 
              href="{{ block.settings.link }}" 
              class="featured-collection__card"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="featured-collection__image-wrapper">
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag: 
                      loading: 'lazy',
                      class: 'featured-collection__image',
                      widths: '300, 400, 500, 600',
                      alt: block.settings.image.alt | default: block.settings.title
                  }}
                </div>
              {%- else -%}
                <div class="featured-collection__image-wrapper featured-collection__image-wrapper--placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
              
              {%- if block.settings.title != blank -%}
                <div class="featured-collection__content">
                  <h3 class="featured-collection__title">{{ block.settings.title }}</h3>
                </div>
              {%- endif -%}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle parent category
    const parentToggles = document.querySelectorAll('[data-parent-toggle]');
    
    parentToggles.forEach(toggle => {
      toggle.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        const parentItem = this.closest('.collections-nav__item--parent');
        const content = parentItem.querySelector('[data-parent-content]');
        
        // Toggle state
        this.setAttribute('aria-expanded', !isExpanded);
        parentItem.classList.toggle('is-expanded', !isExpanded);
        
        if (content) {
          if (!isExpanded) {
            content.style.maxHeight = content.scrollHeight + 'px';
          } else {
            content.style.maxHeight = '0px';
          }
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Collections Page",
  "tag": "section",
  "class": "section-collections-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "parent_category",
      "name": "Parent Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Wine",
          "info": "This is a parent category that can have child categories"
        }
      ]
    },
    {
      "type": "child_category",
      "name": "Child Category",
      "settings": [
        {
          "type": "text",
          "id": "parent_id",
          "label": "Parent Category ID",
          "info": "Copy the parent category block ID here to nest this item under that parent"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Red Wine"
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection Handle",
          "info": "Enter the collection handle (e.g., 'red-wine'). Find this in Products > Collections"
        }
      ]
    },
    {
      "type": "single_category",
      "name": "Single Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Gift"
        },
        {
          "type": "text",
          "id": "collection_handle",
          "label": "Collection Handle",
          "info": "Enter the collection handle (e.g., 'gift'). Find this in Products > Collections"
        }
      ]
    },
    {
      "type": "featured_collection",
      "name": "Featured Collection Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New Arrivals"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to collection or product page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Page",
      "blocks": [
        {
          "type": "parent_category",
          "settings": {
            "title": "Wine"
          }
        },
        {
          "type": "child_category",
          "settings": {
            "title": "Red Wine",
            "collection_handle": "red-wine"
          }
        },
        {
          "type": "child_category",
          "settings": {
            "title": "White Wine",
            "collection_handle": "white-wine"
          }
        },
        {
          "type": "child_category",
          "settings": {
            "title": "Beer",
            "collection_handle": "beer"
          }
        },
        {
          "type": "single_category",
          "settings": {
            "title": "Beverage",
            "collection_handle": "beverage"
          }
        },
        {
          "type": "single_category",
          "settings": {
            "title": "Chinese Cookie",
            "collection_handle": "chinese-cookie"
          }
        },
        {
          "type": "single_category",
          "settings": {
            "title": "Gift",
            "collection_handle": "gift"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "New Arrivals"
          }
        },
        {
          "type": "featured_collection",
          "settings": {
            "title": "Best Seller"
          }
        }
      ]
    }
  ]
}
{% endschema %}

