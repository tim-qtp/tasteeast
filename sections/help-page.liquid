{{ 'section-help-page.css' | asset_url | stylesheet_tag }}

<div class="help-page-container">
  <div class="help-page-inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="help-title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="help-content">
        {{ section.settings.content }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_contact_form -%}
      <div class="contact-section">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="contact-title">{{ section.settings.form_heading }}</h2>
        {%- endif -%}

        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="success-message">
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- elsif form.errors -%}
            <div class="error-message">
              {{ 'templates.contact.form.error_heading' | t }}
            </div>
          {%- endif -%}

          <div class="form-row">
            <div class="form-field">
              <label>Name</label>
              <input type="text" name="contact[Name]" placeholder="Enter your name" required>
            </div>
            <div class="form-field">
              <label>Email</label>
              <input type="email" name="contact[email]" placeholder="your@email.com" required>
            </div>
          </div>

          <div class="form-field">
            <label>Phone Number</label>
            <input type="tel" name="contact[Phone Number]" placeholder="(123) 456-7890">
          </div>

          <div class="form-field">
            <label>Message</label>
            <textarea name="contact[Message]" rows="6" placeholder="How can we help you?" required></textarea>
          </div>

          <input type="hidden" name="contact[recipient]" value="{{ section.settings.recipient_email }}">

          <button type="submit" class="submit-btn">{{ section.settings.button_text }}</button>
        {% endform %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Help Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Help"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Page Content",
      "default": "<p>Welcome to our help center. If you have any questions, please fill out the form below.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_contact_form",
      "label": "Show Contact Form",
      "default": true
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient Email",
      "default": "support@tasteeast.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send"
    }
  ],
  "presets": [
    {
      "name": "Help Page"
    }
  ]
}
{% endschema %}
