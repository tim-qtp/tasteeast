{{ 'section-help-page.css' | asset_url | stylesheet_tag }}

<div class="help-page page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank -%}
    <h1 class="help-page__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.content != blank -%}
    <div class="help-page__content rte">
      {{ section.settings.content }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_contact_form -%}
    <div class="help-contact-form">
      {%- if section.settings.form_heading != blank -%}
        <h2 class="help-contact-form__heading">{{ section.settings.form_heading }}</h2>
      {%- endif -%}

      {% form 'contact' %}
        {%- if form.posted_successfully? -%}
          <div class="form-status form-status--success" tabindex="-1" autofocus>
            {{ 'templates.contact.form.post_success' | t }}
          </div>
        {%- elsif form.errors -%}
          <div class="form-status form-status--error">
            <h2 class="form-status__title">{{ 'templates.contact.form.error_heading' | t }}</h2>
          </div>
        {%- endif -%}

        <div class="help-contact-form__fields">
          <div class="field-group">
            <div class="field field--half">
              <input
                class="field__input"
                autocomplete="name"
                type="text"
                id="ContactForm-name"
                name="contact[{{ 'templates.contact.form.name' | t }}]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ section.settings.name_placeholder }}"
                required
              >
              <label class="field__label" for="ContactForm-name">{{ section.settings.name_placeholder }}</label>
            </div>

            <div class="field field--half">
              <input
                autocomplete="email"
                type="email"
                id="ContactForm-email"
                class="field__input"
                name="contact[email]"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                placeholder="{{ section.settings.email_placeholder }}"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="ContactForm-email-error"
                {% endif %}
                required
              >
              <label class="field__label" for="ContactForm-email">{{ section.settings.email_placeholder }}</label>
            </div>
          </div>

          <div class="field">
            <input
              type="tel"
              id="ContactForm-phone"
              class="field__input"
              autocomplete="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              pattern="[0-9\-]*"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ section.settings.phone_placeholder }}"
            >
            <label class="field__label" for="ContactForm-phone">{{ section.settings.phone_placeholder }}</label>
          </div>

          <div class="field">
            <textarea
              rows="5"
              id="ContactForm-body"
              class="text-area field__input"
              name="contact[{{ 'templates.contact.form.comment' | t }}]"
              placeholder="{{ section.settings.message_placeholder }}"
              required
            >
              {{- form.body -}}
            </textarea>
            <label class="field__label" for="ContactForm-body">{{ section.settings.message_placeholder }}</label>
          </div>
        </div>

        <input type="hidden" name="contact[send_to]" value="{{ section.settings.recipient_email }}">

        <div class="help-contact-form__button">
          <button type="submit" class="button button--primary">
            {{ section.settings.button_text }}
          </button>
        </div>
      {% endform %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Help Page",
  "tag": "section",
  "class": "section-help-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Help"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Page Content",
      "default": "<p>Welcome to our help center. If you have any questions, please fill out the form below.</p>"
    },
    {
      "type": "header",
      "content": "Contact Form Settings"
    },
    {
      "type": "checkbox",
      "id": "show_contact_form",
      "label": "Show Contact Form",
      "default": true
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient Email",
      "info": "Email address to receive form submissions",
      "default": "contact@example.com"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name Field Label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Field Label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_placeholder",
      "label": "Phone Number Field Label",
      "default": "Phone Number"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message Field Label",
      "default": "Message"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Help Page",
      "settings": {
        "heading": "Help",
        "form_heading": "Contact Us"
      }
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

