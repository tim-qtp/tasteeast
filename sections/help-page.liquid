{%- style -%}
  /* 整个 Help Page 文字使用 Carlito */
  .help-page-container,
  .help-page-container * {
    font-family: 'Carlito', sans-serif !important;
  }

  /* 居中整个内容 */
  .help-page-inner {
    max-width: 800px;
    margin: 0 auto; /* ← 居中核心代码 */
    text-align: center;
  }
  

  /* 表单每一项标签 & 输入框靠左对齐（可选） */
  .form-row,
  .form-field {
    text-align: left;
  }

  /* 让表单元素宽度更协调 */
  .form-field input,
  .form-field textarea {
    width: 100%;
  }

  /* 按钮居中 + 调整样式 */
  .submit-btn {
    display: inline-block;
    margin-left:0px;
    background: #d2232a;
    color: #fff;
    padding: 24px 18px;
    font-family: 'Carlito', sans-serif !important;
    cursor: pointer;
  }

  .submit-btn:hover {
    background: #a1191f;
  }
{%- endstyle -%}

{{ 'section-help-page.css' | asset_url | stylesheet_tag }}

<div class="help-page-container">
  <div class="help-page-inner">
    {%- if section.settings.heading != blank -%}
      <h1 class="help-title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="help-content">
        {{ section.settings.content }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_contact_form -%}
      <div class="contact-section">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="contact-title">{{ section.settings.form_heading }}</h2>
        {%- endif -%}

        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="success-message">
              {{ 'templates.contact.form.post_success' | t }}
            </div>
          {%- elsif form.errors -%}
            <div class="error-message">
              {{ 'templates.contact.form.error_heading' | t }}
            </div>
          {%- endif -%}

          <div class="form-row">
            <div class="form-field">
              <label></label>
              <input type="text" name="contact[Name]" placeholder="Enter your name" required>
            </div>
            <div class="form-field">
              <label></label>
              <input type="email" name="contact[email]" placeholder="your@email.com" required>
            </div>
          </div>

          <div class="form-field">
            <label></label>
            <input type="tel" name="contact[Phone Number]" placeholder="(123) 456-7890">
          </div>

          <div class="form-field">
            <label></label>
            <textarea name="contact[Message]" rows="6" placeholder="How can we help you?" required></textarea>
          </div>

          <input type="hidden" name="contact[recipient]" value="{{ section.settings.recipient_email }}">

          <button type="submit" class="submit-btn">{{ section.settings.button_text }}</button>
        {% endform %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Help Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Help"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Page Content",
      "default": "<p>Welcome to our help center. If you have any questions, please fill out the form below.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_contact_form",
      "label": "Show Contact Form",
      "default": true
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Contact Us"
    },
    {
      "type": "text",
      "id": "recipient_email",
      "label": "Recipient Email",
      "default": "support@tasteeast.com"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Send"
    }
  ],
  "presets": [
    {
      "name": "Help Page"
    }
  ]
}
{% endschema %}
