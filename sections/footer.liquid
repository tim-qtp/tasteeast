<footer class="te-footer" style="background-image:url({{ settings.footer_bg | image_url }});">
  <div class="te-footer__overlay" aria-hidden="true"></div>

  <div class="te-footer__wrap">
    <div class="te-footer__grid">
      <!-- 栏目：导航 -->
      <div class="te-footer__col">
        <h4 class="te-footer__title"><a href="/" class="te-footer__home">HOME</a></h4>
        <ul class="te-footer__list">
          <li><a href="#features icon" class="te-footer__link">BOUTIQUE WINES</a></li>
          <li><a href="#china-california" class="te-footer__link">DISCOVER MORE</a></li>
          <li><a href="#PRODUCTS" class="te-footer__link">PRODUCTS</a></li>
          <li><a href="#news" class="te-footer__link">NEWS</a></li>
          <li><a href="#reviews" class="te-footer__link">REVIEWS</a></li>
          <li><a href="#contact" class="te-footer__link">BOOKING</a></li>
        </ul>
      </div>

      <!-- 栏目：快速链接 -->
      <div class="te-footer__col">
        <h4 class="te-footer__title">Quick Links</h4>
        <ul class="te-footer__list">
          <li><a href="/pages/about" class="te-footer__link">ABOUT US</a></li>
          <li><a href="/pages/become-supplier" class="te-footer__link">BECOME SUPPLIERS</a></li>
        </ul>
      </div>

      <!-- 栏目：社交 -->
      <div class="te-footer__col te-footer__social">
        <h4 class="te-footer__title">Follow Us</h4>
        <div class="te-footer__icons">
          <a href="#" class="te-social" aria-label="Facebook" title="Facebook">
            <!-- 简洁SVG，避免依赖字体图标 -->
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M13.5 21v-7h2.3l.3-3h-2.6V9.1c0-.9.2-1.5 1.5-1.5H16V5.1c-.3 0-1.2-.1-2.2-.1-2.2 0-3.8 1.3-3.8 3.9V11H8v3h2v7h3.5z" fill="currentColor"/>
            </svg>
          </a>
          <a href="#" class="te-social" aria-label="Instagram" title="Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm5 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.9a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2zM12 9.5A2.5 2.5 0 1 1 9.5 12 2.5 2.5 0 0 1 12 9.5z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- 底部版权 -->
    <div class="te-footer__bar">
      <div>©2025 TasteEast · All Rights Reserved</div>
      <div class="te-footer__legal">
        <a href="#" class="te-footer__link te-footer__link--muted">Privacy Policy</a>
        <span class="te-footer__sep">•</span>
        <a href="#" class="te-footer__link te-footer__link--muted">Sitemap</a>
      </div>
    </div>
  </div>

  <style>
    /* ====== 基础变量 ====== */
    .te-footer{
      position:relative;
      color:#1f1f1f;
      padding:64px 20px 36px;
      background-repeat:repeat;
      background-size:cover;
      overflow:hidden;
    }
    .te-footer__overlay{
      position:absolute; inset:0;
      background:rgba(255,255,255,.86); /* 柔化纹理，提高可读性 */
      pointer-events:none;
    }
    .te-footer__wrap{ position:relative; z-index:1; max-width:1200px; margin:0 auto; }

    /* ====== 栅格 ====== */
    .te-footer__grid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap:40px;
      align-items:start;
      margin-bottom:28px;
    }
    @media (max-width: 960px){ .te-footer__grid{ grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (max-width: 640px){ .te-footer__grid{ grid-template-columns: 1fr; } }

    /* ====== 标题/列表/链接 ====== */
    .te-footer__title{
      margin:0 0 14px;
      font:700 16px/1.2 "Montserrat", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:#2b2218;
    }
    .te-footer__home{ color:inherit; text-decoration:none; }
    .te-footer__list{ list-style:none; padding:0; margin:0; }
    .te-footer__link{
      display:inline-block;
      padding:6px 0;
      color:#2a2a2a;
      text-decoration:none;
      transition: color .2s ease, text-underline-offset .2s ease;
      text-underline-offset: 4px;
    }
    .te-footer__link:hover{ color:#b78a4a; text-decoration:underline; }
    .te-footer__link:focus-visible{ outline:2px solid #d2ab67; outline-offset:2px; border-radius:4px; }
    .te-footer__link--muted{ color:#555; }
    .te-footer__link--muted:hover{ color:#8f6c3b; }

    /* ====== 社交 ====== */
    .te-footer__icons{ display:flex; gap:12px; }
    .te-social{
      width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center;
      background:#0e1a2a; color:#e4c399; border-radius:999px;
      box-shadow:0 2px 8px rgba(0,0,0,.08);
      transition: transform .2s ease, background .2s ease, color .2s ease;
      text-decoration:none;
    }
    .te-social:hover{ transform:translateY(-2px); background:#12233a; color:#f1d3a6; }
    .te-footer__social .te-footer__title{ margin-bottom:10px; }

    /* ====== 底栏 ====== */
    .te-footer__bar{
      display:flex; justify-content:space-between; align-items:center;
      padding-top:18px; font-size:13px; color:#444;
      border-top:1px solid rgba(0,0,0,.08);
      gap:12px;
    }
    .te-footer__legal{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .te-footer__sep{ color:#999; }
    @media (max-width:640px){
      .te-footer__bar{ flex-direction:column; align-items:flex-start; gap:8px; }
    }
  </style>
</footer>
