{% schema %}
{
  "name": "Feature Icons",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BOUTIQUE WINES"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "EACH BOTTLE TELLS A STORY — OF LAND, LABOR, AND LEGACY."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Icons",
      "category": "Custom",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}

<section id="features icon"
  class="feature-icons-section"
  style="
    position: relative;
    background-image: linear-gradient(rgba(250, 245, 236, 0.95), rgba(250, 245, 236, 0.95)),
                      url({{ section.settings.background_image | image_url: width: 1920 }});
    background-size: cover;
    background-position: center;
    padding: 100px 20px;
  "
>
  <div
    class="feature-icons-container"
    style="
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 60px;
    "
  >
    {% for block in section.blocks %}
      <div
        class="feature-item"
        style="
          flex: 1 1 300px;
          text-align: center;
          max-width: 360px;
          opacity: 0;
          transform: translateY(30px);
          animation: fadeUp 0.8s ease forwards;
          animation-delay: {{ forloop.index | times: 0.1 }}s;
        "
      >
        {% if block.settings.icon != blank %}
          <img
            src="{{ block.settings.icon | image_url: width: 80 }}"
            alt="Icon"
            class="feature-icon"
            style="
              height: 72px;
              margin-bottom: 20px;
              transition: transform 0.3s ease, box-shadow 0.3s ease;
            "
          >
        {% endif %}

        <h3
          style="
            font-family: 'Annapurna SIL', serif;
            font-size: 32px;
            font-weight: 500;
            color: #422A02;
            margin-bottom: 14px;
            letter-spacing: 0.5px;
          "
        >
          {{ block.settings.title }}
        </h3>

        <p
          style="
            font-family: 'Helvetica Neue', sans-serif;
            font-size: 14px;
            line-height: 1.7;
            color: #422A02;
            max-width: 300px;
            margin: 0 auto;
          "
        >
          {{ block.settings.text }}
        </p>
      </div>
    {% endfor %}
  </div>
</section>

<style>
/* 淡入动画 */
@keyframes fadeUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 图标 hover 视觉反馈 */
.feature-icon:hover {
  transform: scale(1.08);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
}

/* 移动端优化 */
@media screen and (max-width: 768px) {
  .feature-icons-container {
    flex-direction: column;
    gap: 40px;
    padding: 0 10px;
  }

  .feature-item h3 {
    font-size: 24px !important;
  }

  .feature-item p {
    font-size: 13px !important;
  }

  .feature-icon {
    height: 64px !important;
  }
}
</style>
