<section class="hero-section">
  <div class="hero-inner">
    <p class="hero-subheading">
      {{ section.settings.subheading }}
    </p>

    <h1 class="hero-heading">
      {{ section.settings.heading }}
    </h1>

    <h2 class="hero-subline">
      {{ section.settings.subline }}
    </h2>

    <div class="hero-button-wrap">
      <a href="#touch" class="hero-button">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
</section>

<style>
/* 🎨 Base Style */
.hero-section {
  background-color: #0f2840;
  color: #fff;
  text-align: center;
  padding: 100px 20px;
  overflow: hidden;
}

.hero-inner {
  max-width: 1200px;
  margin: 0 auto;
}

.hero-subheading {
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #ccc;
  margin-bottom: 20px;
  opacity: 0;
  animation: fadeIn 1s ease forwards;
}

.hero-heading {
  font-size: 184px;
  margin: 0;
  font-family: 'Limelight', serif;
  background: linear-gradient(to right, #d9b989, #e2c59a);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  opacity: 0;
  animation: fadeUp 1.2s ease forwards;
}

.hero-subline {
  font-size: 20px;
  margin-top: 20px;
  font-weight: 600;
  color: #f5d5a2;
  opacity: 0;
  animation: fadeIn 1.2s ease 0.5s forwards;
}

.hero-button-wrap {
  margin-top: 40px;
  opacity: 0;
  animation: fadeIn 1s ease 1s forwards;
}

.hero-button {
  padding: 16px 36px;
  background: linear-gradient(to right, #d9b989, #e2c59a);
  color: #000;
  font-weight: bold;
  border-radius: 4px;
  text-decoration: none;
  display: inline-block;
  transition: all 0.3s ease;
}

.hero-button:hover {
  transform: scale(1.05);
  background: linear-gradient(to left, #d9b989, #e2c59a);
}

/* 📱 Responsive */
@media (max-width: 768px) {
  .hero-heading {
    font-size: 42px !important;
  }
  .hero-subline {
    font-size: 16px !important;
  }
  .hero-button {
    padding: 12px 24px !important;
    font-size: 14px !important;
  }
}

/* ✨ Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>

{% schema %}
{
  "name": "Welcome Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Top Text",
      "default": "LET’S BUILD SOMETHING BEAUTIFUL TOGETHER  BECOME A BRAND PARTNER AT TASTEEAST"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "WELCOME"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline (Below Heading)",
      "default": "ELEVATE TASTE, CULTURE, AND CRAFT"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "APPLY NOW"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button Link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Welcome Hero Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}
