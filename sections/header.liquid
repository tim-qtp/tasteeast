    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  /* =========================
     Category Mega Menu 样式
     ========================= */
 .header__inline-menu {
    margin-left: 3rem;
    display: flex;
    align-items: center;
  }

  .header__inline-menu-item--mega {
    position: relative;
  }

  .mega-menu__toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font: inherit;
    color: inherit;
  }

  .mega-menu__caret {
    font-size: 0.85em;
  }

  .mega-menu {
    position: absolute;
    left: 0;
    top: 100%;
    width: 100vw;
    transform: translateX(calc(-50vw + 50%));
    background: #ffffff;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);
    padding: 28px 0 32px;
    display: none;
    z-index: 30;
  }

  .header__inline-menu-item--mega.is-open .mega-menu,
  .header__inline-menu-item--mega:hover .mega-menu,
  .header__inline-menu-item--mega:focus-within .mega-menu {
    display: block;
  }

  .mega-menu__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 50px;  /* 和 top bar / header 左右对齐 */
  }

  /* 整体布局：左边文字，右边图片 */
  .mega-menu__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1.6fr);
    gap: 48px;
    align-items: flex-start;
  }

  /* 左侧 4 组栏目：2 列 */
  .mega-menu__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 48px;
  }

  .mega-menu__column {
    min-width: 0;
  }

  .mega-menu__heading {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 12px;
  }

  .mega-menu__heading a {
    text-decoration: none;
    color: inherit;
  }

  .mega-menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mega-menu__item + .mega-menu__item {
    margin-top: 8px;
  }

  .mega-menu__link {
    text-decoration: none;
    color: #444;
    font-size: 16px;
  }

  .mega-menu__link:hover {
    color: #000;
  }

  /* 右侧两张大图区域 */
  .mega-menu__promo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .mega-menu__promo-card {
    text-decoration: none;
    color: inherit;
  }

  .mega-menu__promo-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .mega-menu__promo-text {
    margin-top: 8px;
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .mega-menu {
      display: none !important; /* 桌面 mega menu 不在移动端显示 */
    }
  }
</style>

{%- style -%}

  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  /* 让 Header 跟 top bar 一样从左/右顶到 50px */
  .header-wrapper .header.page-width {
    max-width: 100%;      /* 取消居中限制 */
    padding-left: 50px;   /* 和 top bar 的 0 50px 对齐 */
    padding-right: 50px;
  }

  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .header {
    /* 上下内边距：上保留一点，下设为 0 */
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem 0 3rem;
  }

  .header-wrapper .header.page-width {
    max-width: 100%;
    padding-left: 50px;
    padding-right: 50px;
  }

  /* 取消 Header section 自己底部的间距 */
  .section-header {
    position: sticky;
    margin-bottom: 0 !important;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: 0 !important;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: 0 !important;   /* ⭐ 关键：把底部 padding 改成 0 */
    }
  }

  /* =========================
   Header Mobile Responsive
   ========================= */
@media screen and (max-width: 749px) {
  /* 取消桌面 50px padding，改成手机常规 */
  .header-wrapper .header.page-width{
    padding-left: 16px !important;
    padding-right: 16px !important;
  }

  /* Header 主体改成三段：左抽屉/菜单按钮 + 中logo + 右icons */
  .header{
    display: grid !important;
    grid-template-columns: 44px 1fr auto !important;
    align-items: center !important;
    column-gap: 10px !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* 你的桌面自定义 inline menu：手机端隐藏，避免挤压 */
  .header__inline-menu{
    display: none !important;
  }

  /* Mega menu 手机也别显示（你已有，这里再保险） */
  .mega-menu{
    display: none !important;
  }

  /* Logo 居中 + 不要太大 */
  .header__heading-wrapper{
    justify-self: center !important;
  }
  .header__heading-logo-wrapper{
    max-width: 140px;  /* 你想更大就改 160/180 */
  }

  /* 右侧 icons 变紧凑 */
  .header__icons{
    justify-self: end !important;
    gap: 8px !important;
  }

  /* 隐藏 “Login / My Account” 文字，只留 icon（更不挤） */
  .header__login-link span:last-child,
  .header__account-toggle span:last-child{
    display: none !important;
  }

  /* account 下拉按钮别撑宽 */
  .header__account-toggle{
    padding: 0 !important;
    gap: 6px !important;
  }

  /* 搜索弹窗输入框在手机端不要两列布局（你现在有 grid 两列） */
  .predictive-search__results-groups-wrapper{
    grid-template-columns: 1fr !important;
    row-gap: 18px !important;
  }

  /* 搜索框高度更舒服 */
  .search-modal__form .field__input,
  .search-modal__form .search__input{
    padding: 12px 14px !important;
    border-radius: 10px !important;
  }
}

/* 750-989 这段是平板：也建议隐藏桌面 inline menu（可选） */
@media screen and (min-width: 750px) and (max-width: 989px){
  .header__inline-menu{
    display: none !important;
  }
}

{%- endstyle -%}

