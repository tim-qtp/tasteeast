     Search 弹窗样式重置（Header 里的弹窗）
     ========================= */

  /* 整个表单区域：居中 + 更长 */
  .search-modal__form {
    max-width: 960px;           /* 想更长就改这里，比如 960 */
    margin: 0 auto;
  }

  .search-modal__form .field {
    width: 100%;
  }

  /* 细线 + 绿色边框 + 白色底色 */
  .search-modal__form .field__input,
  .search-modal__form .search__input {
    border: 1px solid #216D81;  /* 绿色，按你原需求色号，可替换 */
    border-radius: 4px;
    box-shadow: none;
    padding-left: 14px;
    padding-right: 14px;
    background: #FFFFFF;
    color: #222222;             /* 防止出现“白字看不见”的情况 */
  }

  .search-modal__form .field__input::placeholder,
  .search-modal__form .search__input::placeholder {
    color: #888888;
  }

  .search-modal__form .field__input:focus,
  .search-modal__form .search__input:focus {
    outline: none;
    border-color: #216D81;
    box-shadow: none;
  }

  /* 去掉输入框里边的放大镜按钮（只保留弹窗右上角 X） */
  .search-modal__form .search__button,
  .search-modal__form .field__button,
  .search-modal__form .icon-search {
    display: none !important;
  }

  /* 彻底隐藏 Shopify 默认的放大镜图标 */
.search__form .icon-search,
.field__input + .icon-search {
  display: none !important;
  visibility: hidden !important;
  width: 0 !important;
  height: 0 !important;
}


  /* 预测搜索结果区域，统一文字颜色，避免“白字中文” */
