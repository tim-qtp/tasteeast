<style>
    /* =========================
     Search 弹窗样式重置（只管弹出的搜索层）
     ========================= */

  /* 让弹出层里的搜索区域不再被限制宽度 */
  .search-modal__content {
    max-width: 100% !important;
  }

  .search-modal__form {
    max-width: 100% !important;
    width: 100% !important;
  }

  /* 输入框外层，必须 100% 宽度 */
  .search-modal__form .field {
    width: 100% !important;
    max-width: 100% !important;
  }

  /* 输入框本身：细线边框、绿色边框色你后面可以改成指定色号 */
  .search-modal__form .field__input,
  .search-modal__form .search__input {
    width: 100% !important;
    border: 1px solid #D6D6D6;  /* 细线 */
    border-radius: 4px;
    box-shadow: none;
    padding-left: 14px;          /* 左边留一点内边距 */
  }

  .search-modal__form .field__input:focus,
  .search-modal__form .search__input:focus {
    outline: none;
    border-color: #216D81;       /* 这里换成你要的绿色色号 */
    box-shadow: none;
  }

  /* 去掉输入框右侧的放大镜按钮，只保留右上角的大 X 关闭按钮 */
  .search-modal__form .search__button,
  .search-modal__form .field__button.search__button,
  .search-modal__form .icon-search {
    display: none !important;
  }

  /* =========================
     搜索结果：Suggestions / Products 两栏布局
     ========================= */

  /* 控制左边 Suggestions 和右边 Products 的列宽比例 */
  .predictive-search__results-groups-wrapper {
    display: grid !important;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr) !important;
    column-gap: 32px !important;
  }

  /* 防止产品标题太窄变成一列一列竖排 */
  .predictive-search__item-heading,
  .predictive-search__item .full-unstyled-link {
    white-space: normal !important;
  }
