{% comment %}
  Replace the existing block that starts with:
  {% if link.title == 'Shop' %}
  and ends immediately before its matching {% endif %}.

  This version removes Kitchen, Bar, Home Goods, Kids and promo cards.
  The only category is Juice.
{% endcomment %}

{% if link.title == 'Shop' %}
  <li class="list-menu__item header__inline-menu-item">
    <a
      href="/collections/juice"
      class="list-menu__item list-menu__item--link link"
      aria-label="Shop Juice"
    >
      Juice
    </a>
  </li>
{% else %}
  <li class="list-menu__item header__inline-menu-item">
    <a href="{{ link.url }}" class="list-menu__item list-menu__item--link link">
      {{ link.title }}
    </a>
  </li>
{% endif %}
