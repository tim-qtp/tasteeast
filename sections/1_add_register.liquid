<section class="auth-page" data-auth-page>
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title">Create account</h1>
    </header>

    <div class="auth-page__grid">
      
      <!-- Register Panel -->
      <div class="auth-card auth-card--register">
        <div class="auth-card__body">
          {% form 'create_customer', novalidate: 'novalidate', class: 'auth-form', id: 'AuthRegisterForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                This email address is already associated with an account. If this account is yours, you can <a href="/account/login#recover">reset your password</a>
              </div>
            {% endif %}

            <div class="auth-row auth-row--2">
              <div class="auth-field">
                <input 
                  type="text" 
                  id="customer-first-name"
                  name="customer[first_name]" 
                  autocomplete="given-name" 
                  placeholder="First name" 
                  class="auth-input">
              </div>
              <div class="auth-field">
                <input 
                  type="text"
                  id="customer-last-name" 
                  name="customer[last_name]" 
                  autocomplete="family-name" 
                  placeholder="Last name" 
                  class="auth-input">
              </div>
            </div>
            <div class="auth-row auth-row--2">
              <div class="auth-field">
              <input 
                type="email"
                id="customer-email" 
                name="customer[email]" 
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off" 
                placeholder="Email" 
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="customer-password" 
                name="customer[password]" 
                autocomplete="new-password" 
                placeholder="Password" 
                class="auth-input" 
                required>
            </div>
            </div>
            
            <div class="btn_view">
              <button class="auth-btn" type="submit" data-auth-submit>Create</button>

              <p class="auth-note">
                Returning customer?
                <a class="auth-link" href="{{ routes.account_login_url }}">Sign in</a>
              </p>
            </div>
            
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .btn_view{
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: flex-start;
  }
  /* 白底 */
  section.auth-page,
  .auth-page{
    background:#fff;
    padding: 0 !important;
    padding-bottom: 90px !important;
    min-height: 100vh;
    margin-top: 0 !important;
    display: flex;
    align-items: flex-start;
    padding-top: 80px !important;
  }

  .section + .section.auth-page,
  .section-header ~ .auth-page,
  .section-header ~ section.auth-page {
    margin-top: 0 !important;
  }

  .auth-page__inner {
    padding-top: 0 !important;
    margin-top: 0 !important;
    width: 100%;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 26px;
    margin-top: 0;
    padding-top: 0;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  .auth-page__grid{
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 22px;
  }

  .auth-card{
    width: 100%;
    max-width: 550px;
    background:#fff;
    padding: 28px;
  }

  .auth-form{ display:grid; gap: 14px; }
  .auth-row--2{ display:grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 2px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
    font-size: 15px;
  }
  .auth-input:focus{ outline:none; border-color:#111; }

  .auth-btn{
    width: auto;
    border: 0;
    border-radius: 2px;
    padding: 12px 14px;
    cursor: pointer;
    background:#e85b4f;
    color:#fff;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.2s;
  }
  .auth-btn:hover{
    background:#d94b3f;
  }

  .auth-note{ 
    margin: 6px 0 0; 
    color:#666; 
    text-align: center;
    font-size: 14px;
  }
  
  .auth-link{ 
    color:#1f7ea0; 
    text-decoration: underline;
  }
  .auth-link:hover{
    color:#155a6f;
  }

  .auth-errors{
    background:#fff6f6;
    border:1px solid #ffd5d5;
    padding:10px 12px;
    border-radius:10px;
    color:#d8000c;
    font-size: 14px;
  }
</style>

{% schema %}
{
  "name": "Register Page",
  "settings": []
}
{% endschema %}
