<div class="login-form">
  {%- assign redirect_url = request.params.return_to | default: routes.account_url -%}

  {%- form 'customer_login', novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <div class="login-form__error">
        Incorrect email or password.
      </div>
    {%- endif -%}

    {%- comment -%}
      登录成功后的跳转地址：
      1. 如果 URL 上带了 ?return_to=/xxx，就用这个
      2. 否则默认跳转到账户页 /account
    {%- endcomment -%}
    <input type="hidden" name="return_to" value="{{ redirect_url }}">

    <div class="login-form__field">
      <label class="login-form__label" for="CustomerEmail">Email</label>
      <input
        type="email"
        name="customer[email]"
        id="CustomerEmail"
        class="login-form__input"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        placeholder="Email"
        {% if form.errors contains 'form' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <div class="login-form__field">
      <label class="login-form__label" for="CustomerPassword">Password</label>
      <input
        type="password"
        name="customer[password]"
        id="CustomerPassword"
        class="login-form__input"
        autocomplete="current-password"
        placeholder="Password"
        {% if form.errors contains 'form' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <button class="login-form__button" type="submit">
      Sign in
    </button>

    <div class="login-form__links">
      New Customer? <a href="{{ routes.account_register_url }}" class="login-form__link">Create account</a>
      <br>
      <a href="{{ routes.account_recover_url }}" class="login-form__link">Forgot your password?</a>
    </div>
  {%- endform -%}
</div>
