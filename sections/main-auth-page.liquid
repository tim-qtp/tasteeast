<section class="auth-page" data-auth-page>
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title" data-auth-title>Create account</h1>
    </header>

    <div class="auth-page__grid">
      <!-- Register -->
      <div class="auth-card auth-card--register" data-auth-panel="register">
        <div class="auth-card__body">
          {% form 'create_customer', novalidate: 'novalidate', class: 'auth-form', id: 'AuthRegisterForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-row auth-row--2">
              <div class="auth-field">
                <input 
                  type="text" 
                  id="customer-first-name"
                  name="customer[first_name]" 
                  autocomplete="given-name" 
                  placeholder="First name" 
                  class="auth-input">
              </div>
              <div class="auth-field">
                <input 
                  type="text"
                  id="customer-last-name" 
                  name="customer[last_name]" 
                  autocomplete="family-name" 
                  placeholder="Last name" 
                  class="auth-input">
              </div>
            </div>

            <div class="auth-field">
              <input 
                type="email"
                id="customer-email" 
                name="customer[email]" 
                autocomplete="email" 
                placeholder="Email" 
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="customer-password" 
                name="customer[password]" 
                autocomplete="new-password" 
                placeholder="Password" 
                class="auth-input" 
                required>
            </div>

            <button class="auth-btn" type="submit" data-auth-submit>Create</button>

            <p class="auth-note">
              Returning customer?
              <a class="auth-link" href="#login" data-auth-switch="login">Sign in</a>
            </p>
          {% endform %}
        </div>
      </div>

      <!-- Login -->
      <div class="auth-card auth-card--login" data-auth-panel="login">
        <div class="auth-card__body">
          {% form 'customer_login', novalidate: 'novalidate', class: 'auth-form', id: 'AuthLoginForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input 
                type="email" 
                id="login-customer-email"
                name="customer[email]" 
                autocomplete="email"
                placeholder="Email"
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="login-customer-password" 
                name="customer[password]" 
                autocomplete="current-password"
                placeholder="Password"
                class="auth-input" 
                required>
            </div>

            <button class="auth-btn" type="submit" data-auth-submit>Sign in</button>

            <p class="auth-note">
              <a class="auth-link" href="{{ routes.account_recover_url }}">Forgot password?</a>
              <span style="margin:0 8px;">·</span>
              <a class="auth-link" href="#register" data-auth-switch="register">Create account</a>
            </p>

          {% endform %}
        </div>
      </div>

      <!-- Reset Password -->
      <div class="auth-card auth-card--reset" data-auth-panel="reset">
        <div class="auth-card__body">
          {% form 'reset_customer_password', novalidate: 'novalidate', class: 'auth-form', id: 'AuthResetForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input 
                type="password"
                id="reset-password" 
                name="customer[password]" 
                autocomplete="new-password"
                placeholder="Password"
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="reset-password-confirmation" 
                name="customer[password_confirmation]" 
                autocomplete="new-password"
                placeholder="Confirm password"
                class="auth-input" 
                required>
            </div>

            <button class="auth-btn" type="submit" data-auth-submit>Reset password</button>

            <p class="auth-note">
              <a class="auth-link" href="#login" data-auth-switch="login">Back to sign in</a>
            </p>

          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* 白底：只作用在这个 section 内，不去动 header 结构，避免和主题 sticky 逻辑打架 */
  section.auth-page,
  .auth-page{
    background:#fff;
    padding: 0 !important;
    padding-bottom: 90px !important;
    min-height: 100vh;
    margin-top: 0 !important;
    display: flex;
    align-items: flex-start;
    padding-top: 80px !important;
  }

  /* 移除 section 之间的间距 */
  .section + .section.auth-page,
  .section-header ~ .auth-page,
  .section-header ~ section.auth-page {
    margin-top: 0 !important;
  }

  .auth-page__inner {
    padding-top: 0 !important;
    margin-top: 0 !important;
    width: 100%;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 26px;
    margin-top: 0;
    padding-top: 0;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  /* ✅ 永远单列 + 居中（你现在想先跑通逻辑最稳） */
  .auth-page__grid{
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 22px;
  }

  .auth-card{
    width: 100%;
    max-width: 420px;
    background:#fff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 28px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
  }

  .auth-form{ display:grid; gap: 14px; }
  .auth-row--2{ display:grid; grid-template-columns: 1fr 1fr; gap: 14px; }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
  }
  .auth-input:focus{ outline:none; border-color:#111; }

  .auth-btn{
    width: 100%;
    border: 0;
    border-radius: 8px;
    padding: 12px 14px;
    cursor: pointer;
    background:#e85b4f;
    color:#fff;
    font-weight: 600;
    font-size: 15px;
  }

  .auth-note{ margin: 6px 0 0; color:#666; text-align: center; }
  .auth-link{ color:#1f7ea0; text-decoration: underline; }

  .auth-errors{
    background:#fff6f6;
    border:1px solid #ffd5d5;
    padding:10px 12px;
    border-radius:10px;
    color:#d8000c;
  }

  /* 默认隐藏登录和重置密码面板，由 JS 控制显示 */
  .auth-card--login,
  .auth-card--reset{ 
    display:none; 
  }
</style>

<script>
(function() {
  'use strict';

  // 获取所有面板和标题元素
  const authPage = document.querySelector('[data-auth-page]');
  if (!authPage) return;

  const title = authPage.querySelector('[data-auth-title]');
  const panels = {
    register: authPage.querySelector('[data-auth-panel="register"]'),
    login: authPage.querySelector('[data-auth-panel="login"]'),
    reset: authPage.querySelector('[data-auth-panel="reset"]')
  };

  // 标题文本配置
  const titles = {
    register: 'Create account',
    login: 'Sign in',
    reset: 'Reset password'
  };

  // 切换面板函数
  function switchPanel(panelName) {
    // 隐藏所有面板
    Object.values(panels).forEach(panel => {
      if (panel) panel.style.display = 'none';
    });

    // 显示目标面板
    if (panels[panelName]) {
      panels[panelName].style.display = 'block';
    }

    // 更新标题
    if (title && titles[panelName]) {
      title.textContent = titles[panelName];
    }

    // 更新 URL hash（不刷新页面）
    if (history.pushState) {
      history.pushState(null, null, '#' + panelName);
    } else {
      window.location.hash = panelName;
    }
  }

  // 初始化：根据 URL hash 或默认显示注册面板
  function initPanel() {
    const hash = window.location.hash.replace('#', '');
    
    // 如果 URL 中有 hash 且对应的面板存在，显示该面板
    if (hash && panels[hash]) {
      switchPanel(hash);
    } 
    // 否则默认显示注册面板
    else {
      switchPanel('register');
    }
  }

  // 监听所有切换链接的点击事件
  authPage.addEventListener('click', function(e) {
    const switchLink = e.target.closest('[data-auth-switch]');
    if (switchLink) {
      e.preventDefault();
      const targetPanel = switchLink.getAttribute('data-auth-switch');
      if (targetPanel) {
        switchPanel(targetPanel);
      }
    }
  });

  // 监听浏览器前进/后退按钮
  window.addEventListener('hashchange', function() {
    const hash = window.location.hash.replace('#', '');
    if (hash && panels[hash]) {
      switchPanel(hash);
    }
  });

  // 监听表单提交错误（Shopify 表单验证失败后会刷新页面）
  // 如果有表单错误，确保显示正确的面板
  window.addEventListener('DOMContentLoaded', function() {
    // 检查注册表单错误
    const registerForm = document.getElementById('AuthRegisterForm');
    if (registerForm && registerForm.querySelector('.auth-errors')) {
      switchPanel('register');
      return;
    }

    // 检查登录表单错误
    const loginForm = document.getElementById('AuthLoginForm');
    if (loginForm && loginForm.querySelector('.auth-errors')) {
      switchPanel('login');
      return;
    }

    // 检查重置密码表单错误
    const resetForm = document.getElementById('AuthResetForm');
    if (resetForm && resetForm.querySelector('.auth-errors')) {
      switchPanel('reset');
      return;
    }

    // 如果没有错误，按正常逻辑初始化
    initPanel();
  });

})();
</script>


{% schema %}
{
  "name": "Auth Page",
  "settings": []
}
{% endschema %}
