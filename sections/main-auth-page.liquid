<section class="auth-page" data-auth-page>
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title" data-auth-title>Sign in</h1>
    </header>

    <div class="auth-page__grid">
      
      <!-- Login Panel -->
      <div class="auth-card auth-card--login" data-auth-panel="login">
        <div class="auth-card__body">
          {% form 'customer_login', novalidate: 'novalidate', class: 'auth-form', id: 'AuthLoginForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input 
                type="email" 
                id="login-customer-email"
                name="customer[email]" 
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="Email"
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="login-customer-password" 
                name="customer[password]" 
                autocomplete="current-password"
                placeholder="Password"
                class="auth-input" 
                required>
            </div>
            <div class="btn_view">
                <button class="auth-btn" type="submit" data-auth-submit>Sign in</button>
                <p class="auth-note">
                  New Customer? <a class="auth-link" href="{{ routes.account_register_url }}">Create account</a><br>
                  <a class="auth-link" href="#recover" data-auth-switch="recover">Forgot your password?</a>
                </p>
            </div>
            

          {% endform %}
        </div>
      </div>

      <!-- Recover Password Panel -->
      <div class="auth-card auth-card--recover" data-auth-panel="recover">
        <div class="auth-card__body">
          {% form 'recover_customer_password', novalidate: 'novalidate', class: 'auth-form', id: 'AuthRecoverForm' %}

            {% assign recover_success = form.posted_successfully? %}

            {% if recover_success %}
              <div class="auth-success">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M10 0C4.486 0 0 4.486 0 10s4.486 10 10 10 10-4.486 10-10S15.514 0 10 0zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8z" fill="#0a7a3e"/>
                  <path d="M13.293 6.293L9 10.586 7.707 9.293l-1.414 1.414L9 13.414l5.707-5.707z" fill="#0a7a3e"/>
                </svg>
                {{ 'customer.recover_password.success' | t }}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <p class="auth-subtext">
              {{ 'customer.recover_password.subtext' | t }}
            </p>

            <div class="auth-field">
              <input 
                type="email"
                id="recover-email" 
                name="email" 
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="Email"
                class="auth-input" 
                {% if form.errors %}
                  aria-invalid="true"
                  autofocus
                {% endif %}
                required>
            </div>

            <button class="auth-btn" type="submit" data-auth-submit>
              {{ 'customer.login_page.submit' | t }}
            </button>

            <p class="auth-note">
              <a class="auth-link" href="#login" data-auth-switch="login">
                {{ 'customer.login_page.cancel' | t }}
              </a>
            </p>

          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .btn_view{
    display: flex;
    gap: 16px;
    justify-content: flex-start;
  }
  .auth-errors {
      background: #fce2e1;
      border: 1px solid #ffd5d5;
      padding: 5px 12px;
      border-radius: 0;
      color: #d8000c;
      font-size: 14px;
  }
  .auth-errors ul{
    list-style: none;
    padding: 0px;
    margin: 0px;
  }

  /* 白底：只作用在这个 section 内 */
  section.auth-page,
  .auth-page{
    background:#fff;
    padding: 0 !important;
    padding-bottom: 90px !important;
    min-height: 100vh;
    margin-top: 0 !important;
    display: flex;
    align-items: flex-start;
    padding-top: 80px !important;
  }

  /* 移除 section 之间的间距 */
  .section + .section.auth-page,
  .section-header ~ .auth-page,
  .section-header ~ section.auth-page {
    margin-top: 0 !important;
  }

  .auth-page__inner {
    padding-top: 0 !important;
    margin-top: 0 !important;
    width: 100%;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 26px;
    margin-top: 0;
    padding-top: 0;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  .auth-page__grid{
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 22px;
  }

  .auth-card{
    width: 100%;
    max-width: 420px;
    background:#fff;
    border-radius: 12px;
    padding: 28px;
  }

  .auth-form{ display:grid; gap: 14px; }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 5px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
    font-size: 15px;
  }
  .auth-input:focus{ outline:none; border-color:#111; }

  .auth-btn{
    width: auto;
    border: 0;
    border-radius: 8px;
    padding: 12px 14px;
    cursor: pointer;
    background:#e85b4f;
    color:#fff;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.2s;
  }
  .auth-btn:hover{
    background:#d94b3f;
  }

  .auth-note{ 

    margin: 6px 0 0; 
    color:#666; 
    text-align: center;
    font-size: 14px;
  }
  
  .auth-link{ 
    color:#1f7ea0; 
    text-decoration: underline;
    cursor: pointer;
  }
  .auth-link:hover{
    color:#155a6f;
  }

  .auth-success{
    background:#f0fdf4;
    border:1px solid #86efac;
    padding:12px 14px;
    border-radius:10px;
    color:#0a7a3e;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .auth-subtext{
    color:#666;
    font-size: 14px;
    margin: 0 0 8px 0;
    line-height: 1.5;
  }

  /* 默认隐藏忘记密码面板 */
  .auth-card--recover{ 
    display:none; 
  }
</style>

<script>
(function() {
  'use strict';

  const authPage = document.querySelector('[data-auth-page]');
  if (!authPage) return;

  const title = authPage.querySelector('[data-auth-title]');
  const panels = {
    login: authPage.querySelector('[data-auth-panel="login"]'),
    recover: authPage.querySelector('[data-auth-panel="recover"]')
  };

  const titles = {
    login: 'Sign in',
    recover: 'Reset your password'
  };

  // 切换面板函数
  function switchPanel(panelName) {
    // 隐藏所有面板
    Object.values(panels).forEach(panel => {
      if (panel) panel.style.display = 'none';
    });

    // 显示目标面板
    if (panels[panelName]) {
      panels[panelName].style.display = 'block';
    }

    // 更新标题
    if (title && titles[panelName]) {
      title.textContent = titles[panelName];
    }

    // 更新 URL hash
    if (history.pushState) {
      history.pushState(null, null, '#' + panelName);
    } else {
      window.location.hash = panelName;
    }
  }

  // 初始化
  function initPanel() {
    const hash = window.location.hash.replace('#', '');
    
    // 检查是否有表单错误
    const recoverForm = document.getElementById('AuthRecoverForm');
    if (recoverForm && (recoverForm.querySelector('.auth-errors') || recoverForm.querySelector('.auth-success'))) {
      switchPanel('recover');
      return;
    }

    const loginForm = document.getElementById('AuthLoginForm');
    if (loginForm && loginForm.querySelector('.auth-errors')) {
      switchPanel('login');
      return;
    }

    // 根据 hash 显示面板
    if (hash === 'recover' && panels.recover) {
      switchPanel('recover');
    } else {
      switchPanel('login');
    }
  }

  // 监听切换链接点击
  authPage.addEventListener('click', function(e) {
    const switchLink = e.target.closest('[data-auth-switch]');
    if (switchLink) {
      e.preventDefault();
      const targetPanel = switchLink.getAttribute('data-auth-switch');
      if (targetPanel) {
        switchPanel(targetPanel);
      }
    }
  });

  // 监听浏览器前进/后退
  window.addEventListener('hashchange', function() {
    const hash = window.location.hash.replace('#', '');
    if (hash && panels[hash]) {
      switchPanel(hash);
    } else {
      switchPanel('login');
    }
  });

  // 页面加载时初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPanel);
  } else {
    initPanel();
  }

})();
</script>

{% schema %}
{
  "name": "Login Page",
  "settings": []
}
{% endschema %}
