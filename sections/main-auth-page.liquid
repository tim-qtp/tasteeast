<section class="auth-page">
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title">Create account</h1>
    </header>

    <div class="auth-page__grid">

      <!-- LEFT: Register -->
      <div class="auth-card">
        <div class="auth-card__body">
          {% form 'create_customer', novalidate: 'novalidate', class: 'auth-form' %}
            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-row auth-row--2">
              <div class="auth-field">
                <input type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" class="auth-input">
              </div>
              <div class="auth-field">
                <input type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" class="auth-input">
              </div>
            </div>

            <div class="auth-field">
              <input type="email" name="customer[email]" autocomplete="email" placeholder="Email" class="auth-input" required>
            </div>

            <div class="auth-field">
              <input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" class="auth-input" required>
            </div>

            {% assign reg_submit = 'customer.register.submit' | t %}
            {% if reg_submit contains 'Translation missing' %}{% assign reg_submit = 'Create' %}{% endif %}

            <button class="auth-btn" type="submit">{{ reg_submit }}</button>

            <p class="auth-note">
              Returning customer?
              <a class="auth-link" href="#auth-login">Sign in</a>
            </p>
          {% endform %}
        </div>
      </div>

      <!-- RIGHT: Login -->
      <div class="auth-card" id="auth-login">
        <div class="auth-card__body">
          {% form 'customer_login', novalidate: 'novalidate', class: 'auth-form' %}
            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input type="email" name="customer[email]" autocomplete="email" placeholder="Email" class="auth-input" required>
            </div>

            <div class="auth-field">
              <input type="password" name="customer[password]" autocomplete="current-password" placeholder="Password" class="auth-input" required>
            </div>

            {% assign sign_in = 'customer.login.sign_in' | t %}
            {% if sign_in contains 'Translation missing' %}{% assign sign_in = 'Sign in' %}{% endif %}

            <button class="auth-btn" type="submit">{{ sign_in }}</button>

            <p class="auth-note">
              <a class="auth-link" href="{{ routes.account_recover_url }}">Forgot password?</a>
            </p>
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* 整页白底（关键） */
  #MainContent,
  .auth-page{
    background:#fff !important;
  }

  .auth-page{
    padding: 60px 0 90px;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 34px;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  .auth-page__grid{
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }

  @media (min-width: 900px){
    .auth-page__grid{
      grid-template-columns: 1fr 1fr;
    }
  }

  .auth-card{
    background:#fff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 28px;
  }

  .auth-form{
    display:grid;
    gap: 14px;
  }

  .auth-row--2{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
  }

  .auth-input:focus{
    outline:none;
    border-color:#111;
  }

  .auth-btn{
    width: 120px;
    border: 0;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    background:#e85b4f;  /* 你截图里按钮偏红 */
    color:#fff;
    font-weight: 600;
  }

  .auth-note{
    margin: 6px 0 0;
    color:#666;
  }

  .auth-link{
    color:#1f7ea0; /* 截图里偏蓝 */
    text-decoration: underline;
  }

  .auth-errors{
    background:#fff6f6;
    border:1px solid #ffd5d5;
    padding:10px 12px;
    border-radius:10px;
  }
  /* 只在 page.auth 这个模板强制白底（不影响其它页面） */
.template-page-auth,
.template-page-auth body,
.template-page-auth .gradient,
.template-page-auth #MainContent,
.template-page-auth .content-for-layout,
.template-page-auth .shopify-section,
.template-page-auth .auth-page{
  background:#fff !important;
}

</style>

{% schema %}
{
  "name": "Auth Page",
  "settings": []
}
{% endschema %}
