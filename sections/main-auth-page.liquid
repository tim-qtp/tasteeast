<section class="auth-page">
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title">Create account</h1>
    </header>

    <div class="auth-page__grid">

      <!-- LEFT: Register -->
      <div class="auth-card auth-card--register">

        <div class="auth-card__body">
          {% form 'create_customer', novalidate: 'novalidate', class: 'auth-form' %}
            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-row auth-row--2">
              <div class="auth-field">
                <input type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" class="auth-input">
              </div>
              <div class="auth-field">
                <input type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" class="auth-input">
              </div>
            </div>

            <div class="auth-field">
              <input type="email" name="customer[email]" autocomplete="email" placeholder="Email" class="auth-input" required>
            </div>

            <div class="auth-field">
              <input type="password" name="customer[password]" autocomplete="new-password" placeholder="Password" class="auth-input" required>
            </div>

            {% assign reg_submit = 'customer.register.submit' | t %}
            {% if reg_submit contains 'Translation missing' %}{% assign reg_submit = 'Create' %}{% endif %}

            <button class="auth-btn" type="submit">{{ reg_submit }}</button>

            <p class="auth-note">
              Returning customer?
              <a class="auth-link" href="#auth-login">Sign in</a>
            </p>
          {% endform %}
        </div>
      </div>

      <!-- RIGHT: Login -->
      <div class="auth-card auth-card--login" id="auth-login">

        <div class="auth-card__body">
          {% form 'customer_login', novalidate: 'novalidate', class: 'auth-form' %}
            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input type="email" name="customer[email]" autocomplete="email" placeholder="Email" class="auth-input" required>
            </div>

            <div class="auth-field">
              <input type="password" name="customer[password]" autocomplete="current-password" placeholder="Password" class="auth-input" required>
            </div>

            {% assign sign_in = 'customer.login.sign_in' | t %}
            {% if sign_in contains 'Translation missing' %}{% assign sign_in = 'Sign in' %}{% endif %}

            <button class="auth-btn" type="submit">{{ sign_in }}</button>

            <p class="auth-note">
              <a class="auth-link" href="{{ routes.account_recover_url }}">Forgot password?</a>
            </p>
          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* 整页白底（关键） */
  #MainContent,
  .auth-page{
    background:#fff !important;
  }

  .auth-page{
    padding: 60px 0 90px;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 34px;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  .auth-page__grid{
    max-width: 860px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
  }

  @media (min-width: 900px){
    .auth-page__grid{
      grid-template-columns: 1fr 1fr;
    }
  }

  .auth-card{
    background:#fff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 28px;
  }

  .auth-form{
    display:grid;
    gap: 14px;
  }

  .auth-row--2{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 8px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
  }

  .auth-input:focus{
    outline:none;
    border-color:#111;
  }

  .auth-btn{
    width: 120px;
    border: 0;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    background:#e85b4f;  /* 你截图里按钮偏红 */
    color:#fff;
    font-weight: 600;
  }

  .auth-note{
    margin: 6px 0 0;
    color:#666;
  }

  .auth-link{
    color:#1f7ea0; /* 截图里偏蓝 */
    text-decoration: underline;
  }

  .auth-errors{
    background:#fff6f6;
    border:1px solid #ffd5d5;
    padding:10px 12px;
    border-radius:10px;
  }
  /* 只在 page.auth 这个模板强制白底（不影响其它页面） */
.template-page-auth,
.template-page-auth body,
.template-page-auth .gradient,
.template-page-auth #MainContent,
.template-page-auth .content-for-layout,
.template-page-auth .shopify-section,
.template-page-auth .auth-page{
  background:#fff !important;
}
/* 只在这个模板页生效：page.auth */
body.template-page-auth,
body.template-page-auth #MainContent{
  background:#fff !important;
}

/* 防止主题用 ::before 之类铺底图（有些主题这么做） */
body.template-page-auth::before,
body.template-page-auth #MainContent::before{
  display:none !important;
  content:none !important;
}
/* 默认：只显示注册 */
.auth-card--login{
  display: none;
}
/* 当只显示注册时，让卡片居中 */


.auth-card--register {
  width: 100%;
  max-width: 420px;   /* 控制卡片宽度，按你设计图 */
}


.auth-page__header {
  margin-bottom: 48px;
}

.auth-card {
  box-shadow: 0 8px 30px rgba(0,0,0,0.04);
}
/* ⭐ 核心修复：只有注册显示时，强制单列 grid */
.auth-card--login {
  display: none;
}

.auth-page__grid {
  grid-template-columns: 1fr !important;
}
/* ⭐ 真正居中注册卡片 */
.auth-card--register {
  max-width: 420px;
  width: 100%;
  margin: 0 auto;
}
/* ✅ 只在 Auth 模板页：消灭 sticky header 预留的占位空白 + 让导航下方是白色 */
body.template-page-auth .content-for-layout,
body.template-page-auth #MainContent{
  padding-top: 0 !important;
  margin-top: 0 !important;
}

/* Dawn 常见：sticky header 会给 content-for-layout 加 padding-top */
body.template-page-auth .shopify-section-header-sticky ~ .content-for-layout{
  padding-top: 0 !important;
}

/* 让 header 自己在 Auth 页也变白（避免看到那块米色纹理） */
body.template-page-auth .section-header,
body.template-page-auth .header-wrapper,
body.template-page-auth .header-wrapper.gradient{
  background: #fff !important;
  background-image: none !important;
}
/* ===============================
  Auth Page: 强制去掉全站背景图 + 白底接住 Header
  只影响 /pages/auth (template: page.auth)
=============================== */

body.template-page-auth{
  background: #fff !important;
  background-image: none !important;
}

body.template-page-auth .gradient,
body.template-page-auth #MainContent,
body.template-page-auth .content-for-layout{
  background: #fff !important;
  background-image: none !important;
}

/* Header group 也强制白底，避免导航下面露出底图 */
body.template-page-auth .shopify-section-group-header-group,
body.template-page-auth .shopify-section-group-header-group .gradient,
body.template-page-auth .section-header,
body.template-page-auth .header-wrapper{
  background: #fff !important;
  background-image: none !important;
}

/* 有些主题会用 ::before 铺背景图 */
body.template-page-auth::before,
body.template-page-auth .gradient::before,
body.template-page-auth .header-wrapper::before,
body.template-page-auth #MainContent::before{
  content: none !important;
  display: none !important;
}

/* 如果你想让注册区域更贴近导航，把这里调小（比如 20/24） */
body.template-page-auth .auth-page{
  padding-top: 24px !important;
}
/* ✅ Auth 页：隐藏 Header 组里那个“自定义 Liquid”造成的占位（只影响 page.auth） */
body.template-page-auth .shopify-section-group-header-group .shopify-section[id*="custom_liquid"],
body.template-page-auth .shopify-section-group-header-group .shopify-section[id*="custom-liquid"],
body.template-page-auth .shopify-section-group-header-group .shopify-section[id*="customliquid"],
body.template-page-auth .shopify-section-group-header-group .custom-liquid,
body.template-page-auth .shopify-section-group-header-group .custom-liquid__container{
  display: none !important;
  height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}
/* ===============================
   🔥 终极方案：Auth Page 直接 absolute 到 Header 下面
   只影响 page.auth
=============================== */

/* 1️⃣ 让 body 成为定位参照 */
body.template-page-auth{
  position: relative !important;
  background: #fff !important;
}

/* 2️⃣ Header 高度（你 header 实测大概 120～140px）
   👉 如果你觉得还有 1px 缝，直接调这个数值 */
body.template-page-auth{
  --auth-header-offset: 140px;
}

/* 3️⃣ 直接把整个 auth-page 拉到 header 下面 */
body.template-page-auth .auth-page{
  position: absolute !important;
  top: var(--auth-header-offset) !important;
  left: 0;
  right: 0;

  padding-top: 24px !important;   /* 内容内部留一点呼吸 */
  margin: 0 !important;

  background: #fff !important;
  z-index: 1;
}

/* 4️⃣ 禁掉 Shopify 给 MainContent / content-for-layout 的一切占位 */
body.template-page-auth #MainContent,
body.template-page-auth .content-for-layout{
  padding-top: 0 !important;
  margin-top: 0 !important;
  min-height: 0 !important;
}

/* 5️⃣ Header 本身保持正常层级 */
body.template-page-auth .section-header,
body.template-page-auth .header-wrapper{
  position: relative !important;
  z-index: 10;
  background: #fff !important;
}

/* 6️⃣ 防止任何残留背景图 */
body.template-page-auth *,
body.template-page-auth *::before,
body.template-page-auth *::after{
  background-image: none !important;
}
/* ===============================
   Auth Page：强制消灭 Header 预留占位
   兼容不同主题 body class（template-suffix-auth / page-auth 等）
=============================== */

/* 1) 锁定“auth 模板页”的多种可能 body class */
body[class*="auth"],
body[class*="template-suffix-auth"],
body[class*="page-auth"]{
  background:#fff !important;
  background-image:none !important;
}

/* 2) 关键：取消 sticky header 给内容区加的 padding-top */
body[class*="auth"] .shopify-section-header-sticky ~ .content-for-layout,
body[class*="template-suffix-auth"] .shopify-section-header-sticky ~ .content-for-layout,
body[class*="page-auth"] .shopify-section-header-sticky ~ .content-for-layout{
  padding-top: 0 !important;
}

/* 3) 有些主题不是用 ~ 选择器，而是直接给 content-for-layout 加 padding-top */
body[class*="auth"] .content-for-layout,
body[class*="template-suffix-auth"] .content-for-layout,
body[class*="page-auth"] .content-for-layout{
  padding-top: 0 !important;
  margin-top: 0 !important;
  background:#fff !important;
}

/* 4) 如果你的主题“仍然留了一个 header-height 占位”，就用负 margin 抵消（你要的 absolute 效果） */
body[class*="auth"] .auth-page,
body[class*="template-suffix-auth"] .auth-page,
body[class*="page-auth"] .auth-page{
  padding-top: 0 !important;
  margin-top: calc(var(--header-height, 0px) * -1) !important;
  background:#fff !important;
}

/* 5) Header 本身也强制白底，避免导航下露出底图/渐变 */
body[class*="auth"] .section-header,
body[class*="auth"] .header-wrapper,
body[class*="template-suffix-auth"] .section-header,
body[class*="template-suffix-auth"] .header-wrapper,
body[class*="page-auth"] .section-header,
body[class*="page-auth"] .header-wrapper{
  background:#fff !important;
  background-image:none !important;
}

</style>

{% schema %}
{
  "name": "Auth Page",
  "settings": []
}
{% endschema %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const signInLink = document.querySelector('.auth-link[href="#auth-login"]');
    const loginCard = document.querySelector('.auth-card--login');
    const registerCard = document.querySelector('.auth-card:not(.auth-card--login)');

    if (!signInLink || !loginCard || !registerCard) return;

    signInLink.addEventListener('click', function (e) {
      e.preventDefault();
      registerCard.style.display = 'none';
      loginCard.style.display = 'block';
      loginCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>
