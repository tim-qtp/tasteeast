{%- style -%}
.addr-page *{
  color:#000;
}
.addr-page{
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 20px;
}
.addr-title{
  text-align:center;
  font-size:44px;
  font-weight:800;
  margin: 10px 0 40px;
}

.addr-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items:start;
}
@media (max-width: 900px){
  .addr-grid{ grid-template-columns: 1fr; }
}

/* 无地址时：让右侧表单居中 */
.addr-grid.is-empty{
  grid-template-columns: 1fr;
}
.addr-grid.is-empty .addr-right{
  display:flex;
  justify-content:center;
}
.addr-grid.is-empty .form-wrap{
  width: 100%;
  max-width: 520px;
}

.addr-col-title{
  font-size: 26px;
  font-weight: 800;
  margin: 0 0 18px;
}

.addr-card{
  border: 1px solid rgba(18,18,18,.10);
  border-radius: 0px;
  padding: 18px 18px 16px;
  margin-bottom: 18px;
  background: #fff;
}
.addr-card .default-badge{
  margin-top: 10px;
  font-style: italic;
  color: rgba(18,18,18,.65);
}
.addr-actions{
  margin-top: 14px;
  display:flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
}
.addr-btn, .addr-actions button{
  display:inline-block;
  padding: 10px 18px;
  border-radius: 0;
  border: 1px solid rgba(18,18,18,.18);
  text-decoration:none;
  font-weight: 700;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
}
.addr-btn--primary{
  background: #e05a3b;
  border-color: #e05a3b;
  color:#fff;
}
.addr-btn--ghost{
  background:#fff;
  color:#e05a3b;
  border-color: rgba(224,90,59,.5);
}
.addr-empty{
  color: rgba(18,18,18,.7);
  line-height:1.6;
}

.form-wrap{
  max-width: 520px;
}
.form-grid-2{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.form-field{
  margin-bottom: 14px;
}
.form-input, .form-select{
  width: 100%;
  height: 44px;
  border: 1px solid rgba(18,18,18,.18);
  border-radius: 4px;
  padding: 10px 12px;
  font-size: 14px;
}
.form-check{
  display:flex;
  align-items:center;
  gap: 10px;
  margin: 14px 0 18px;
  color: rgba(18,18,18,.8);
}
.addr_gird {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
}
.addr-page{
  background-color:#fff;
  max-width: 100%;
  margin: 0 auto;
  padding: 120px 50px;
}
@media (max-width:789px){
  .addr_gird{
    grid-template-columns: 1fr;
  }
  .addr-page{
    padding: 80px 20px;
  }
}
{%- endstyle -%}

{%- assign has_addresses = customer.addresses_count | plus: 0 -%}

<div class="addr-page">
  <h1 class="addr-title">My Addresses</h1>

  <div class="addr-grid {% if has_addresses == 0 %}is-empty{% endif %}">
    {% comment %} LEFT: Existing addresses (only show when has addresses) {% endcomment %}
    {% if has_addresses > 0 %}
      <div class="addr-left">
        <h2 class="addr-col-title">Addresses</h2>
        <div class="addr_gird"> 
        {%- for address in customer.addresses -%}
          <div class="addr-card">
            {{ address | format_address }}

            {%- if address == customer.default_address -%}
              <div class="default-badge">Default address</div>
            {%- endif -%}

            <div class="addr-actions">
              <a class="addr-btn addr-btn--primary" href="{{ routes.account_addresses_url }}#EditAddress_{{ address.id }}">
                Edit
              </a>

              <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
                <input type="hidden" name="_method" value="delete">
                <button class="addr-btn addr-btn--ghost" type="submit">
                  Delete
                </button>
              </form>
            </div>
          </div>
        {%- endfor -%}
        </div>
      </div>
    {% endif %}

    {% comment %} RIGHT: Add new address form (always show) {% endcomment %}
    <div class="addr-right">
      <div class="form-wrap">
        <h2 class="addr-col-title">Add a new Address</h2>

        {% form 'customer_address', customer.new_address %}
          <div class="form-grid-2">
            <div class="form-field">
              <input class="form-input" name="address[first_name]" placeholder="First name" value="{{ form.first_name }}">
            </div>
            <div class="form-field">
              <input class="form-input" name="address[last_name]" placeholder="Last name" value="{{ form.last_name }}">
            </div>
          </div>

          <div class="form-field">
            <input class="form-input" name="address[company]" placeholder="Company" value="{{ form.company }}">
          </div>

          <div class="form-field">
            <input class="form-input" name="address[address1]" placeholder="Address 1" value="{{ form.address1 }}">
          </div>

          <div class="form-field">
            <input class="form-input" name="address[address2]" placeholder="Address 2" value="{{ form.address2 }}">
          </div>

          <div class="form-grid-2">
            <div class="form-field">
              <input class="form-input" name="address[city]" placeholder="City" value="{{ form.city }}">
            </div>

            <div class="form-field">
              <select class="form-select" name="address[country]" data-default="{{ form.country }}">
                {{ all_country_option_tags }}
              </select>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-field">
              <input class="form-input" name="address[zip]" placeholder="Zip/Postal Code" value="{{ form.zip }}">
            </div>
            <div class="form-field">
              <input class="form-input" name="address[phone]" placeholder="Phone" value="{{ form.phone }}">
            </div>
          </div>

          <label class="form-check">
            <input type="checkbox" name="address[default]" value="1">
            <span>Set as default address</span>
          </label>

          <button class="addr-btn addr-btn--primary" type="submit">Add address</button>
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main addresses",
  "settings": []
}
{% endschema %}
