<link rel="stylesheet" href="{{ 'customer-account.css' | asset_url }}">

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer-page addresses-page section-{{ section.id }}-padding">
  <h1 class="customer-page__title">My Addresses</h1>

  <div class="addresses-container{% if customer.addresses.size == 0 %} addresses-container--empty{% endif %}">
    {/* Left Side: Addresses List (only show if addresses exist) */}
    {%- if customer.addresses.size > 0 -%}
      <div>
        <h2 style="font-size: 20px; font-weight: 700; margin-bottom: 24px;">Addresses</h2>
        <div class="addresses-list">
          {%- for address in customer.addresses -%}
            <div class="address-card">
              <div class="address-card__content">
                <strong>{{ address.first_name }} {{ address.last_name }}</strong><br>
                {{ address.address1 }}<br>
                {%- if address.address2 != blank -%}
                  {{ address.address2 }}<br>
                {%- endif -%}
                {{ address.city }}, {{ address.province_code }}<br>
                {{ address.country }} {{ address.zip }}<br>
                {{ address.phone }}
              </div>
              
              {%- if address == customer.default_address -%}
                <div class="address-card__default">Default address</div>
              {%- endif -%}

              <div class="address-card__actions">
                <button 
                  class="address-card__button address-card__button--edit"
                  onclick="editAddress({{ address.id }})"
                >
                  Edit
                </button>
                <button 
                  class="address-card__button address-card__button--delete"
                  onclick="deleteAddress({{ address.id }}, '{{ address | json | escape }}')"
                >
                  Delete
                </button>
              </div>

              {/* Hidden edit form for this address */}
              <div id="EditAddress_{{ address.id }}" style="display: none;">
                {%- form 'customer_address', address -%}
                  <input type="hidden" name="_method" value="put">
                  {{ form | default_errors }}
                  
                  <div style="margin-top: 20px;">
                    <div class="address-form__row">
                      <div class="address-form__field">
                        <label class="address-form__label">First name</label>
                        <input type="text" name="address[first_name]" value="{{ form.first_name }}" class="address-form__input">
                      </div>
                      <div class="address-form__field">
                        <label class="address-form__label">Last name</label>
                        <input type="text" name="address[last_name]" value="{{ form.last_name }}" class="address-form__input">
                      </div>
                    </div>
                    
                    <div class="address-form__field">
                      <label class="address-form__label">Company</label>
                      <input type="text" name="address[company]" value="{{ form.company }}" class="address-form__input">
                    </div>
                    
                    <div class="address-form__field">
                      <label class="address-form__label">Address 1</label>
                      <input type="text" name="address[address1]" value="{{ form.address1 }}" class="address-form__input">
                    </div>
                    
                    <div class="address-form__field">
                      <label class="address-form__label">Address 2</label>
                      <input type="text" name="address[address2]" value="{{ form.address2 }}" class="address-form__input">
                    </div>
                    
                    <div class="address-form__row">
                      <div class="address-form__field">
                        <label class="address-form__label">City</label>
                        <input type="text" name="address[city]" value="{{ form.city }}" class="address-form__input">
                      </div>
                      <div class="address-form__field">
                        <label class="address-form__label">Country</label>
                        <select name="address[country]" data-default="{{ form.country }}" class="address-form__select">
                          {{ all_country_option_tags }}
                        </select>
                      </div>
                    </div>
                    
                    <div class="address-form__row">
                      <div class="address-form__field">
                        <label class="address-form__label">Zip/Postal Code</label>
                        <input type="text" name="address[zip]" value="{{ form.zip }}" class="address-form__input">
                      </div>
                      <div class="address-form__field">
                        <label class="address-form__label">Phone</label>
                        <input type="tel" name="address[phone]" value="{{ form.phone }}" class="address-form__input">
                      </div>
                    </div>
                    
                    <div class="address-form__checkbox-wrapper">
                      <input type="checkbox" name="address[default]" id="address_default_{{ address.id }}" value="1" {% if address == customer.default_address %}checked{% endif %} class="address-form__checkbox">
                      <label for="address_default_{{ address.id }}" class="address-form__checkbox-label">Set as default address</label>
                    </div>
                    
                    <div style="display: flex; gap: 12px;">
                      <button type="submit" class="address-form__button" style="flex: 1;">Save</button>
                      <button type="button" onclick="cancelEdit({{ address.id }})" class="address-form__button" style="flex: 1; background: transparent; border: 1px solid rgba(var(--color-foreground), 0.3); color: rgb(var(--color-foreground));">Cancel</button>
                    </div>
                  </div>
                {%- endform -%}
              </div>

              {/* Hidden delete form */}
              <div id="DeleteAddress_{{ address.id }}" style="display: none;">
                {%- form 'customer_address', address -%}
                  <input type="hidden" name="_method" value="delete">
                {%- endform -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {/* Right Side or Centered: Add New Address Form */}
    <div class="address-form-container{% if customer.addresses.size == 0 %} address-form-container--centered{% endif %}">
      <h2 class="address-form__title">
        {%- if customer.addresses.size > 0 -%}
          Add a new Address
        {%- else -%}
          My Addresses
        {%- endif -%}
      </h2>
      
      {%- form 'customer_address', customer.new_address -%}
        {{ form | default_errors }}
        
        <div class="address-form__row">
          <div class="address-form__field">
            <label class="address-form__label">First name</label>
            <input type="text" name="address[first_name]" value="{{ form.first_name }}" placeholder="First name" class="address-form__input">
          </div>
          <div class="address-form__field">
            <label class="address-form__label">Last name</label>
            <input type="text" name="address[last_name]" value="{{ form.last_name }}" placeholder="Last name" class="address-form__input">
          </div>
        </div>
        
        <div class="address-form__field">
          <label class="address-form__label">Company</label>
          <input type="text" name="address[company]" value="{{ form.company }}" placeholder="Company" class="address-form__input">
        </div>
        
        <div class="address-form__field">
          <label class="address-form__label">Address 1</label>
          <input type="text" name="address[address1]" value="{{ form.address1 }}" placeholder="Address 1" class="address-form__input">
        </div>
        
        <div class="address-form__field">
          <label class="address-form__label">Address 2</label>
          <input type="text" name="address[address2]" value="{{ form.address2 }}" placeholder="Address 2" class="address-form__input">
        </div>
        
        <div class="address-form__row">
          <div class="address-form__field">
            <label class="address-form__label">City</label>
            <input type="text" name="address[city]" value="{{ form.city }}" placeholder="City" class="address-form__input">
          </div>
          <div class="address-form__field">
            <label class="address-form__label">Country</label>
            <select name="address[country]" data-default="{{ form.country }}" class="address-form__select">
              <option value="">---</option>
              {{ all_country_option_tags }}
            </select>
          </div>
        </div>
        
        <div class="address-form__row">
          <div class="address-form__field">
            <label class="address-form__label">Zip/Postal Code</label>
            <input type="text" name="address[zip]" value="{{ form.zip }}" placeholder="Zip/Postal Code" class="address-form__input">
          </div>
          <div class="address-form__field">
            <label class="address-form__label">Phone</label>
            <input type="tel" name="address[phone]" value="{{ form.phone }}" placeholder="Phone" class="address-form__input">
          </div>
        </div>
        
        <div class="address-form__checkbox-wrapper">
          <input type="checkbox" name="address[default]" id="address_default_new" value="1" class="address-form__checkbox">
          <label for="address_default_new" class="address-form__checkbox-label">Set as default address</label>
        </div>
        
        <button type="submit" class="address-form__button">
          Add address
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

<script>
  function editAddress(addressId) {
    const editForm = document.getElementById('EditAddress_' + addressId);
    const card = editForm.closest('.address-card');
    const content = card.querySelector('.address-card__content');
    const actions = card.querySelector('.address-card__actions');
    const defaultBadge = card.querySelector('.address-card__default');
    
    if (content) content.style.display = 'none';
    if (actions) actions.style.display = 'none';
    if (defaultBadge) defaultBadge.style.display = 'none';
    editForm.style.display = 'block';
  }
  
  function cancelEdit(addressId) {
    const editForm = document.getElementById('EditAddress_' + addressId);
    const card = editForm.closest('.address-card');
    const content = card.querySelector('.address-card__content');
    const actions = card.querySelector('.address-card__actions');
    const defaultBadge = card.querySelector('.address-card__default');
    
    if (content) content.style.display = 'block';
    if (actions) actions.style.display = 'flex';
    if (defaultBadge) defaultBadge.style.display = 'block';
    editForm.style.display = 'none';
  }
  
  function deleteAddress(addressId, addressData) {
    if (confirm('Are you sure you want to delete this address?')) {
      document.querySelector('#DeleteAddress_' + addressId + ' form').submit();
    }
  }
</script>

{% schema %}
{
  "name": "Addresses",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
