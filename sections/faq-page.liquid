{{ 'section-faq-page.css' | asset_url | stylesheet_tag }}

<div class="faq-page page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="faq-page__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <!-- FAQ Category Cards -->
    <div class="faq-categories">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <div class="faq-category-card" data-target="#category-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="faq-category-icon">
              {%- if block.settings.icon == 'orders' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M20 20h20v20h-20z M25 25h10v10h-10z M30 20v5 M35 25h5 M35 30h5 M30 35v5 M25 30h-5 M25 25h-5" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.icon == 'shipping' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M18 25h14v10h-14z M32 28h6l4 4v3h-10v-7z M24 38a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M38 38a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.icon == 'returns' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M30 20v20 M20 30h20 M25 25l-5 5 5 5 M35 25l5 5-5 5" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.icon == 'warranty' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M22 22h16v12l-8 6-8-6v-12z M26 26h8 M26 30h8 M26 34h8" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.icon == 'wholesale' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M22 28h16v12h-16z M26 24h8v4h-8z M26 32h3 M26 36h3 M33 32h3 M33 36h3" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- elsif block.settings.icon == 'giftcard' -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <path d="M20 26h20v12h-20z M20 30h20 M28 26v12 M32 26v12 M25 23a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M35 23a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              {%- else -%}
                <svg width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="60" height="60" rx="30" fill="#F5F5F5"/>
                  <circle cx="30" cy="30" r="8" stroke="#333" stroke-width="1.5"/>
                </svg>
              {%- endif -%}
            </div>
            <h3 class="faq-category-title">{{ block.settings.title }}</h3>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- FAQ Content Sections -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <div id="category-{{ block.id }}" class="faq-category-section" {{ block.shopify_attributes }}>
          <h2 class="faq-category-section__title">{{ block.settings.title }}</h2>
          
          {%- if block.settings.questions != blank -%}
            <div class="faq-accordion">
              {%- assign questions = block.settings.questions | newline_to_br | split: '<br />' -%}
              {%- assign answers = block.settings.answers | newline_to_br | split: '<br />' -%}
              
              {%- for question in questions -%}
                {%- if question != blank -%}
                  <details class="faq-accordion__item">
                    <summary class="faq-accordion__question">
                      {{ question }}
                      <svg class="faq-accordion__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </summary>
                    <div class="faq-accordion__answer">
                      {{ answers[forloop.index0] }}
                    </div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Smooth scroll to category when card is clicked
    const categoryCards = document.querySelectorAll('.faq-category-card');
    
    categoryCards.forEach(card => {
      card.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 100; // Offset for fixed header
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ Page",
  "tag": "section",
  "class": "section-faq-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "FAQ Category",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "orders",
              "label": "Orders"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "warranty",
              "label": "Warranty"
            },
            {
              "value": "wholesale",
              "label": "Wholesale"
            },
            {
              "value": "giftcard",
              "label": "Gift Cards"
            }
          ],
          "default": "orders"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Orders"
        },
        {
          "type": "textarea",
          "id": "questions",
          "label": "Questions (one per line)",
          "info": "Enter each question on a new line",
          "default": "How do I track my order?\nCan I modify or cancel after it has been placed?\nWhat payment methods do you accept?"
        },
        {
          "type": "textarea",
          "id": "answers",
          "label": "Answers (one per line, matching order of questions)",
          "info": "Enter each answer on a new line, in the same order as questions",
          "default": "You will receive a tracking number via email once your order ships.\nPlease contact us within 1 hour of placing your order for modifications.\nWe accept all major credit cards, PayPal, and Apple Pay."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "orders",
            "title": "Orders"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "shipping",
            "title": "Shipping"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "returns",
            "title": "Returns"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "warranty",
            "title": "Warranty"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "wholesale",
            "title": "Wholesale"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "giftcard",
            "title": "Gift Cards"
          }
        }
      ]
    }
  ]
}
{% endschema %}

