{{ 'section-faq-page.css' | asset_url | stylesheet_tag }}

<div class="faq-page page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="faq-page__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- comment -%} Collect all categories {%- endcomment -%}
  {%- assign categories = section.blocks | where: 'type', 'category' -%}
  {%- assign questions = section.blocks | where: 'type', 'question' -%}

  {%- if categories.size > 0 -%}
    <!-- FAQ Category Cards -->
    <div class="faq-categories">
      {%- for category in categories -%}
        <div class="faq-category-card" data-target="#category-{{ category.id }}" {{ category.shopify_attributes }}>
          <div class="faq-category-icon">
            {%- if category.settings.icon == 'orders' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 10h20v20h-20z M15 15h10v10h-10z M20 10v5 M25 15h5 M25 20h5 M20 25v5 M15 20h-5 M15 15h-5" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'shipping' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 15h14v10h-14z M22 18h6l4 4v3h-10v-7z M14 28a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M28 28a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'returns' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M28 22h-16v-6h16M12 16l-4 4 4 4M20 10v20" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'warranty' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 12h16v12l-8 6-8-6v-12z M16 16h8 M16 20h8 M16 24h8" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'wholesale' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 18h16v12h-16z M16 14h8v4h-8z M16 22h3 M16 26h3 M23 22h3 M23 26h3" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'giftcard' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 16h20v12h-20z M10 20h20 M18 16v12 M22 16v12 M15 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M25 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'payment' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 12h24v16h-24z M8 18h24 M14 22h4 M20 22h4" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'account' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="14" r="5" stroke="#333" stroke-width="1.5"/>
                <path d="M10 30c0-5.5 4.5-10 10-10s10 4.5 10 10" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {%- elsif category.settings.icon == 'product' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 10h20v20h-20z M14 14h12v12h-12z" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {%- elsif category.settings.icon == 'general' -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="8" stroke="#333" stroke-width="1.5"/>
                <path d="M20 12v8 M20 28v-4" stroke="#333" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="20" r="8" stroke="#333" stroke-width="1.5"/>
              </svg>
            {%- endif -%}
          </div>
          <h3 class="faq-category-title">{{ category.settings.title }}</h3>
        </div>
      {%- endfor -%}
    </div>

    <!-- FAQ Content Sections -->
    {%- for category in categories -%}
      {%- comment -%} Find questions that belong to this category {%- endcomment -%}
      {%- assign category_questions_array = '' | split: ',' -%}
      
      {%- for question in questions -%}
        {%- assign question_category = question.settings.category_title | strip | downcase -%}
        {%- assign category_title = category.settings.title | strip | downcase -%}
        {%- if question_category == category_title -%}
          {%- assign category_questions_array = category_questions_array | push: question -%}
        {%- endif -%}
      {%- endfor -%}
      
      {%- if category_questions_array.size > 0 -%}
        <div id="category-{{ category.id }}" class="faq-category-section" {{ category.shopify_attributes }}>
          <h2 class="faq-category-section__title">{{ category.settings.title }}</h2>
          
          <div class="faq-accordion">
            {%- for question in category_questions_array -%}
              <details class="faq-accordion__item" {{ question.shopify_attributes }}>
                <summary class="faq-accordion__question">
                  {{ question.settings.question }}
                  <svg class="faq-accordion__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </summary>
                <div class="faq-accordion__answer">
                  {{ question.settings.answer }}
                </div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Smooth scroll to category when card is clicked
    const categoryCards = document.querySelectorAll('.faq-category-card');
    
    categoryCards.forEach(card => {
      card.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 100; // Offset for fixed header
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ页面",
  "tag": "section",
  "class": "section-faq-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "页面标题",
      "default": "常见问题"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "FAQ分类",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "分类标题",
          "default": "订单问题",
          "info": "这个标题会显示在分类卡片上，也会作为分类区域的标题。建议使用简洁明了的名称，例如：订单问题、配送问题、退货问题等。"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "图标",
          "info": "选择显示在分类卡片上的图标",
          "options": [
            {
              "value": "orders",
              "label": "订单"
            },
            {
              "value": "shipping",
              "label": "配送"
            },
            {
              "value": "returns",
              "label": "退货"
            },
            {
              "value": "warranty",
              "label": "保修"
            },
            {
              "value": "wholesale",
              "label": "批发"
            },
            {
              "value": "giftcard",
              "label": "礼品卡"
            },
            {
              "value": "payment",
              "label": "支付"
            },
            {
              "value": "account",
              "label": "账户"
            },
            {
              "value": "product",
              "label": "产品"
            },
            {
              "value": "general",
              "label": "通用"
            }
          ],
          "default": "orders"
        }
      ]
    },
    {
      "type": "question",
      "name": "FAQ问题",
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "所属分类",
          "info": "⚠️ 重要：请输入这个问题所属的分类标题。必须与上面创建的「分类标题」完全一致（不区分大小写，会自动去除空格）。例如：如果分类标题是「订单问题」，这里也输入「订单问题」。"
        },
        {
          "type": "text",
          "id": "question",
          "label": "问题",
          "default": "如何查询订单状态？"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "答案",
          "default": "<p>您可以在订单确认邮件中找到追踪号码，或登录账户查看订单详情。</p>",
          "info": "支持富文本格式，可以添加链接、加粗等格式。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ页面",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "orders",
            "title": "订单问题"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "shipping",
            "title": "配送问题"
          }
        }
      ]
    }
  ]
}
{% endschema %}
