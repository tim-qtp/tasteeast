{{ 'section-faq-page.css' | asset_url | stylesheet_tag }}

<div class="faq-page page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="faq-page__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <!-- FAQ Category Cards -->
    <div class="faq-categories">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <div class="faq-category-card" data-target="#category-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="faq-category-icon">
              {%- if block.settings.icon == 'orders' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 10h20v20h-20z M15 15h10v10h-10z M20 10v5 M25 15h5 M25 20h5 M20 25v5 M15 20h-5 M15 15h-5" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- elsif block.settings.icon == 'shipping' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 15h14v10h-14z M22 18h6l4 4v3h-10v-7z M14 28a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M28 28a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- elsif block.settings.icon == 'returns' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M28 22h-16v-6h16M12 16l-4 4 4 4M20 10v20" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- elsif block.settings.icon == 'warranty' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 12h16v12l-8 6-8-6v-12z M16 16h8 M16 20h8 M16 24h8" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- elsif block.settings.icon == 'wholesale' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 18h16v12h-16z M16 14h8v4h-8z M16 22h3 M16 26h3 M23 22h3 M23 26h3" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- elsif block.settings.icon == 'giftcard' -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 16h20v12h-20z M10 20h20 M18 16v12 M22 16v12 M15 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M25 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="20" cy="20" r="8" stroke="#333" stroke-width="1.5"/>
                </svg>
              {%- endif -%}
            </div>
            <h3 class="faq-category-title">{{ block.settings.title }}</h3>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- FAQ Content Sections -->
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <div id="category-{{ block.id }}" class="faq-category-section" {{ block.shopify_attributes }}>
          <h2 class="faq-category-section__title">{{ block.settings.title }}</h2>
          
          {%- if block.settings.questions != blank -%}
            <div class="faq-accordion">
              {%- assign questions = block.settings.questions | newline_to_br | split: '<br />' -%}
              {%- assign answers = block.settings.answers | newline_to_br | split: '<br />' -%}
              
              {%- for question in questions -%}
                {%- if question != blank -%}
                  <details class="faq-accordion__item">
                    <summary class="faq-accordion__question">
                      {{ question }}
                      <svg class="faq-accordion__icon" width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </summary>
                    <div class="faq-accordion__answer">
                      {{ answers[forloop.index0] }}
                    </div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Smooth scroll to category when card is clicked
    const categoryCards = document.querySelectorAll('.faq-category-card');
    
    categoryCards.forEach(card => {
      card.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const targetElement = document.querySelector(targetId);
        
        if (targetElement) {
          const offset = 100; // Offset for fixed header
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - offset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ Page",
  "tag": "section",
  "class": "section-faq-page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "FAQ"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "FAQ Category",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "orders",
              "label": "Orders"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "warranty",
              "label": "Warranty"
            },
            {
              "value": "wholesale",
              "label": "Wholesale"
            },
            {
              "value": "giftcard",
              "label": "Gift Cards"
            }
          ],
          "default": "orders"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Orders"
        },
        {
          "type": "textarea",
          "id": "questions",
          "label": "Questions (one per line)",
          "info": "Enter each question on a new line",
          "default": "How do I track my order?\nCan I modify or cancel after it has been placed?\nWhat payment methods do you accept?"
        },
        {
          "type": "textarea",
          "id": "answers",
          "label": "Answers (one per line, matching order of questions)",
          "info": "Enter each answer on a new line, in the same order as questions",
          "default": "You will receive a tracking number via email once your order ships.\nPlease contact us within 1 hour of placing your order for modifications.\nWe accept all major credit cards, PayPal, and Apple Pay."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Page",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "icon": "orders",
            "title": "Orders"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "shipping",
            "title": "Shipping"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "returns",
            "title": "Returns"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "warranty",
            "title": "Warranty"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "wholesale",
            "title": "Wholesale"
          }
        },
        {
          "type": "category",
          "settings": {
            "icon": "giftcard",
            "title": "Gift Cards"
          }
        }
      ]
    }
  ]
}
{% endschema %}

