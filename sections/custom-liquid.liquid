{%- style -%}
  /* 整个 section 内所有文字使用 Carlito */
  .section-{{ section.id }}-padding,
  .section-{{ section.id }}-padding * {
    font-family: 'Carlito', sans-serif !important;
  }

  /* 保留原有 padding 逻辑 */
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 顶部整体栏：左导航 + 右侧语言 & 社媒 */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 50px;
  }

  /* 左侧小导航区域布局 */
  .top-links {
    display: flex;
    justify-content: flex-start;
    gap: 24px;
  }

  /* 默认 & 访问过 = 黑色，无下划线 */
  .top-links a,
  .top-links a:link,
  .top-links a:visited {
    color: #000 !important;
    text-decoration: none !important;
    font-size: 16px;
  }

  /* 悬停时变色 */
  .top-links a:hover,
  .top-links a:focus,
  .top-links a:visited:hover {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 当前页（active）一直保持高亮色 */
  .top-links a.active,
  .top-links a.active:visited {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  .top-links a:active {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 右侧语言 + 社媒区域 */
  .top-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* 语言选择下拉样式 */
  .language-switcher select {
    font-family: 'Carlito', sans-serif;
    font-size: 14px;
    padding: 4px 8px;
    border-radius: 4px;
    border: 1px solid #ddd;
    background-color: #fff;
    cursor: pointer;
  }

  .language-switcher select:focus {
    outline: none;
    border-color: #216D81;
  }

  /* 社媒图标容器 */
  .social-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .social-icons svg {
    width: 18px;
    height: 18px;
    stroke: #000;
    fill: none;
    transition: stroke 0.2s ease;
  }

  .social-icons a:hover svg {
    stroke: #216D81;
  }
{%- endstyle -%}

<div class="top-bar">
  <!-- 左侧标签导航 -->
  <div class="top-links">
    <a href="/pages/faq"
       class="{% if request.path == '/pages/faq' %}active{% endif %}">
      FAQ
    </a>

    <a href="/pages/cooperation"
       class="{% if request.path == '/pages/cooperation' %}active{% endif %}">
      Cooperation
    </a>

    <a href="/pages/help"
       class="{% if request.path == '/pages/help' %}active{% endif %}">
      Help
    </a>

    <a href="/pages/shipping-return"
       class="{% if request.path == '/pages/shipping-return' %}active{% endif %}">
      Shipping & Return
    </a>
  </div>

  <!-- 右侧：语言切换 + 社媒图标 -->
  <div class="top-right">
    {%- form 'localization', class: 'language-switcher' -%}
      <select name="locale_code" onchange="this.form.submit()">
        {%- for language in localization.available_languages -%}
          <option value="{{ language.iso_code }}"
            {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
            {{ language.endonym_name }}
          </option>
        {%- endfor -%}
      </select>
    {%- endform -%}

    <div class="social-icons">
      {%- if settings.social_facebook_link != blank -%}
        <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24">
            <path d="M14 8h2V4h-2c-3 0-4 2-4 4v2H8v4h2v6h4v-6h3l1-4h-4v-2c0-0.8 0.2-2 2-2z" />
          </svg>
        </a>
      {%- endif -%}

      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17" cy="7" r="1" />
          </svg>
        </a>
      {%- endif -%}

      {%- if settings.social_twitter_link != blank -%}
        <a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter / X">
          <svg viewBox="0 0 24 24">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
