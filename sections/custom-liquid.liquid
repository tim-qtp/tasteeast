{%- style -%}
  /* 整个 section 内所有文字使用 Carlito */
  .section-{{ section.id }}-padding,
  .section-{{ section.id }}-padding * {
    font-family: 'Carlito', sans-serif !important;
  }

  /* 保留原有 padding 逻辑 */
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 顶部小导航区域布局 */
  .top-links {
    display: flex;
    justify-content: left;
    gap: 24px;
    padding-left: 50px;
    font-family: 'Carlito', sans-serif !important;
  }

  /* 默认 & 访问过 = 黑色，无下划线 */
  .top-links a,
  .top-links a:link,
  .top-links a:visited {
    color: #000 !important;
    text-decoration: none !important;
    font-size: 16px;
  }

  /* 悬停时变红 */
  .top-links a:hover,
  .top-links a:focus,
  .top-links a:visited:hover {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 当前页（active）一直保持红色 */
  .top-links a.active,
  .top-links a.active:visited {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 点击按住那一瞬间稍深一点（可留可删） */
  .top-links a:active {
    color: #216D81 !important;
    text-decoration: none !important;
  }
{%- endstyle -%}


<div class="top-links">
  <a href="/pages/faq"
     class="{% if request.path contains '/pages/faq' %}active{% endif %}">
    FAQ
  </a>

  <a href="/pages/cooperation"
     class="{% if request.path contains '/pages/cooperation' %}active{% endif %}">
    Cooperation
  </a>

  <a href="/pages/help"
     class="{% if request.path contains '/pages/help' %}{% endif %}">
    Help
  </a>

  <a href="/pages/shipping-return"
     class="{% if request.path contains '/policies/shipping-policy' or request.path contains 'shipping-policy' %}active{% endif %}">
    Shipping & Return
  </a>
</div>
