<section class="custom-liquid-section">
  {{ section.settings.custom_liquid }}
</section>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "section",
  "class": "section-custom-liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid code"
    }
  ],
  "presets": [
    {
      "name": "Custom Liquid"
    }
  ]
}
{% endschema %}