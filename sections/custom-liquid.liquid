{%- style -%}
  /* 整个 section 内所有文字使用 Carlito */
  .section-{{ section.id }}-padding,
  .section-{{ section.id }}-padding * {
    font-family: 'Carlito', sans-serif !important;
  }

  /* 链接：默认和已访问——无下划线、继承文字颜色 */
  .section-{{ section.id }}-padding a,
  .section-{{ section.id }}-padding a:link,
  .section-{{ section.id }}-padding a:visited {
    text-decoration: none !important;
    color: inherit !important;
  }

  /* 悬停/聚焦时变化字体颜色 */
  .section-{{ section.id }}-padding a:hover,
  .section-{{ section.id }}-padding a:focus {
    text-decoration: none !important;
    color: #d2232a !important; /* ← 自定义高亮颜色 */
  }

  /* 按下状态颜色（可改可删） */
  .section-{{ section.id }}-padding a:active {
    text-decoration: none !important;
    color: #a1191f !important;
  }

  /* 保留原有 padding 逻辑 */
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

.top-links {
  display: flex;
  justify-content: left; /* 居中展示 */
  gap: 24px; /* 链接之间距离 */
  padding-left: 10px; /* 上下留白不挤 */
  font-family: 'Carlito', sans-serif !important;
}

/* 链接样式统一为黑色无下划线 */
.top-links a {
  color: #000 !important; 
  text-decoration: none !important;
  font-size: 16px;
}

/* 悬停时只变颜色 */
.top-links a:hover {
  color: #d2232a !important; /* 高亮颜色可替换 */
}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}



<div class="top-links">
  <a href="/pages/faq">FAQ</a>
  <a href="/pages/cooperation">Cooperation</a>
  <a href="/pages/help">Help</a>
  <a href="/policies/shipping-policy">Shipping & Return</a>
</div>
