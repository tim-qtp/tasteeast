{%- style -%}
  /* 整个 section 内所有文字使用 Carlito */
  .section-{{ section.id }}-padding,
  .section-{{ section.id }}-padding * {
    font-family: 'Carlito', sans-serif !important;
  }

  /* 保留原有 padding 逻辑 */
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 顶部整体栏：左导航 + 右侧社媒&语言 */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 0 50px;
  }

  /* 左侧小导航区域布局 */
  .top-links {
    display: flex;
    justify-content: flex-start;
    gap: 24px;
  }

  /* 默认 & 访问过 = 黑色，无下划线 */
  .top-links a,
  .top-links a:link,
  .top-links a:visited {
    color: #000 !important;
    text-decoration: none !important;
    font-size: 16px;
  }

  /* 悬停时变色 */
  .top-links a:hover,
  .top-links a:focus,
  .top-links a:visited:hover {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 当前页（active）一直保持高亮色 */
  .top-links a.active,
  .top-links a.active:visited {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  .top-links a:active {
    color: #216D81 !important;
    text-decoration: none !important;
  }

  /* 右侧语言 + 社媒区域 */
  .top-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* 语言选择下拉样式 */
  .language-switcher select {
    font-family: 'Carlito', sans-serif;
    font-size: 14px;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid #ddd;
    background-color: #fff;
    cursor: pointer;
  }

  .language-switcher select:focus {
    outline: none;
    border-color: #216D81;
  }

  /* 社媒图标容器 */
  .header-social-icons {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .header-social-icons a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .header-social-icons svg {
    width: 18px;
    height: 18px;
    stroke: #000;
    fill: none;
    transition: stroke 0.2s ease;
  }

  .header-social-icons a:hover svg {
    stroke: #216D81;
  }
  /* =========================
   Mobile Responsive Top Bar
   ========================= */

/* 默认：允许换行，防止小屏挤爆 */
.top-bar{
  flex-wrap: wrap;
}

/* 手机：改成两行布局 + 更紧凑 */
@media screen and (max-width: 749px) {
  .top-bar{
    padding: 0 16px;           /* 手机左右留白 */
    gap: 10px;
    align-items: stretch;
  }

  /* 右侧块：社媒 + 语言 在一行 */
  .top-right{
    width: 100%;
    justify-content: space-between;
    gap: 12px;
  }

  /* 社媒图标缩小一点 */
  .header-social-icons svg{
    width: 16px;
    height: 16px;
  }

  /* 语言下拉缩小，更高级的“轻量”风格 */
  .language-switcher select{
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 999px;      /* 胶囊 */
  }

  /* 左侧导航：改为横向滚动，不换行，不挤压 */
  .top-links{
    width: 100%;
    order: 2;                  /* 放到第二行 */
    gap: 14px;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
    scrollbar-width: none;     /* Firefox 隐藏滚动条 */
  }
  .top-links::-webkit-scrollbar{
    display: none;             /* Chrome/Safari 隐藏滚动条 */
  }

  /* 导航文字稍微小一点，保持一行 */
  .top-links a,
  .top-links a:link,
  .top-links a:visited{
    font-size: 14px;
    white-space: nowrap;
    flex: 0 0 auto;
  }
}

/* 超小屏（可选）：进一步紧凑 */
@media screen and (max-width: 380px){
  .top-bar{ padding: 0 12px; }
  .top-links{ gap: 12px; }
  .top-links a{ font-size: 13px; }
}

{%- endstyle -%}

<div class="top-bar">
  <!-- 左侧标签导航 -->
