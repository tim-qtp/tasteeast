<section class="auth-page" data-auth-page>
  <div class="page-width auth-page__inner">
    <header class="auth-page__header">
      <h1 class="auth-page__title" data-auth-title>Login</h1>
    </header>

    <div class="auth-page__grid">
      
      <!-- Login Panel -->
      <div class="auth-card auth-card--login" data-auth-panel="login">
        <div class="auth-card__body">
          {% form 'reset_customer_password', class: 'auth-form', id: 'AuthLoginForm' %}

            {% if form.errors %}
              <div class="auth-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="auth-field">
              <input 
                type="email" 
                id="login-customer-email"
                name="customer[email]" 
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                placeholder="Email"
                class="auth-input" 
                required>
            </div>

            <div class="auth-field">
              <input 
                type="password"
                id="login-customer-password" 
                name="customer[password]" 
                autocomplete="current-password"
                placeholder="Password"
                class="auth-input" 
                required>
            </div>
            <div class="btn_view">
                <button class="auth-btn" type="submit" data-auth-submit>Sign in</button>
                <p class="auth-note">
                  New Customer? <a class="auth-link" href="{{ routes.account_register_url }}">Create account</a><br>
                  <a class="auth-link" href="#recover" data-auth-switch="recover">Forgot your password?</a>
                </p>
            </div>
            

          {% endform %}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
   a.auth-btn.cancel_btn {
      background-color: #fff;
      color: #e85b4f;
      border: 1px solid #cdcdcd;
  }
  .rest_btn_view{
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .reset_title {
      font-size: 21px;
      margin: 0;
      color: #000;
  }
  .btn_view{
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: flex-start;
  }
  .auth-errors {
      background: #fce2e1;
      border: 1px solid #ffd5d5;
      padding: 5px 12px;
      border-radius: 0;
      color: #d8000c;
      font-size: 14px;
  }
  .auth-errors ul{
    list-style: none;
    padding: 0px;
    margin: 0px;
  }

  /* 白底：只作用在这个 section 内 */
  section.auth-page,
  .auth-page{
    background:#fff;
    padding: 0 !important;
    padding-bottom: 90px !important;
    min-height: 100vh;
    margin-top: 0 !important;
    display: flex;
    align-items: flex-start;
    padding-top: 80px !important;
  }

  /* 移除 section 之间的间距 */
  .section + .section.auth-page,
  .section-header ~ .auth-page,
  .section-header ~ section.auth-page {
    margin-top: 0 !important;
  }

  .auth-page__inner {
    padding-top: 0 !important;
    margin-top: 0 !important;
    width: 100%;
  }

  .auth-page__header{
    text-align:center;
    margin-bottom: 26px;
    margin-top: 0;
    padding-top: 0;
  }

  .auth-page__title{
    margin: 0;
    font-size: 44px;
    line-height: 1.1;
    font-weight: 700;
    color:#111;
  }

  .auth-page__grid{
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: 22px;
  }

  .auth-card{
    width: 100%;
    max-width: 420px;
    background:#fff;
    border-radius: 12px;
    padding: 28px;
  }

  .auth-form{ display:grid; gap: 14px; }

  .auth-input{
    width:100%;
    border: 1px solid #e3e3e3;
    border-radius: 5px;
    padding: 12px 14px;
    background:#fff;
    color:#111;
    font-size: 15px;
  }
  .auth-input:focus{ outline:none; border-color:#111; }

  .auth-btn{
    width: auto;
    border: 0;
    border-radius: 5px;
    padding: 12px 14px;
    cursor: pointer;
    background:#e85b4f;
    color:#fff;
    line-height: 1;
    text-decoration:unset;
    font-weight: 600;
    font-size: 15px;
    transition: background 0.2s;
  }
  .auth-btn:hover{
    background:#d94b3f;
  }

  .auth-note{ 
    margin: 6px 0 0; 
    color:#666; 
    text-align: left;
    font-size: 14px;
  }
  
  .auth-link{ 
    color:#1f7ea0; 
    text-decoration: underline;
    cursor: pointer;
  }
  .auth-link:hover{
    color:#155a6f;
  }

  .auth-success{
    background:#f0fdf4;
    border:1px solid #86efac;
    padding:12px 14px;
    border-radius:10px;
    color:#0a7a3e;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .auth-subtext{
    color:#666;
    font-size: 14px;
    margin: 0 0 8px 0;
    line-height: 1.5;
  }

  /* 默认隐藏忘记密码面板 */
  .auth-card--recover{ 
    display:none; 
  }
</style>

{% schema %}
{
  "name": "Register",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ]
}
{% endschema %}
