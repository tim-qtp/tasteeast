      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% assign news_link_1 = '/blogs/news' %}\n{% assign news_link_2 = '/blogs/news' %}\n{% assign news_link_3 = '/blogs/news' %}\n\n<style>\n  #recent-news-{{ section.id }} {\n    --rn-dark: #161616;\n    --rn-paper: #f2f0ea;\n    --rn-line: rgba(242, 240, 234, .28);\n    --rn-ink: #171717;\n    overflow: hidden;\n    background: var(--rn-dark);\n    color: var(--rn-paper);\n  }\n\n  #recent-news-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #recent-news-{{ section.id }} .rn-shell {\n    width: min(100%, 1680px);\n    margin: 0 auto;\n    padding: clamp(84px, 10vw, 170px) clamp(24px, 4vw, 72px) clamp(90px, 11vw, 180px);\n  }\n\n  #recent-news-{{ section.id }} .rn-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 40px;\n    margin-bottom: clamp(58px, 8vw, 120px);\n    align-items: end;\n  }\n\n  #recent-news-{{ section.id }} .rn-title {\n    max-width: 8ch;\n    margin: 0;\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(68px, 11vw, 180px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .82;\n    letter-spacing: -.07em;\n    text-transform: uppercase;\n    color: var(--rn-paper) !important;\n    -webkit-text-fill-color: var(--rn-paper);\n  }\n\n  #recent-news-{{ section.id }} .rn-all {\n    display: inline-flex;\n    padding-bottom: 7px;\n    align-items: center;\n    gap: 14px;\n    border-bottom: 1px solid currentColor;\n    color: inherit;\n    font: 500 12px/1.2 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .11em;\n    text-decoration: none;\n    text-transform: uppercase;\n  }\n\n  #recent-news-{{ section.id }} .rn-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    border-top: 1px solid var(--rn-line);\n    border-bottom: 1px solid var(--rn-line);\n  }\n\n  #recent-news-{{ section.id }} .rn-card {\n    display: flex;\n    min-width: 0;\n    padding: 18px;\n    flex-direction: column;\n    color: inherit;\n    text-decoration: none;\n  }\n\n  #recent-news-{{ section.id }} .rn-card + .rn-card {\n    border-left: 1px solid var(--rn-line);\n  }\n\n  #recent-news-{{ section.id }} .rn-media {\n    position: relative;\n    aspect-ratio: 4 / 3;\n    overflow: hidden;\n    background: #292929;\n  }\n\n  #recent-news-{{ section.id }} .rn-image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 700ms cubic-bezier(.22, 1, .36, 1), filter 400ms ease;\n  }\n\n  #recent-news-{{ section.id }} .rn-index {\n    position: absolute;\n    z-index: 1;\n    top: 18px;\n    left: 18px;\n    display: grid;\n    width: 38px;\n    height: 38px;\n    place-items: center;\n    border-radius: 50%;\n    background: var(--rn-paper);\n    color: var(--rn-ink);\n    font: 500 11px/1 var(--font-body-family, Arial, sans-serif);\n  }\n\n  #recent-news-{{ section.id }} .rn-content {\n    display: grid;\n    grid-template-columns: 1fr auto;\n    gap: 26px;\n    min-height: 210px;\n    padding: 28px 2px 18px;\n  }\n\n  #recent-news-{{ section.id }} .rn-card-title {\n    max-width: 14ch;\n    margin: 0;\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(29px, 2.7vw, 48px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: 1;\n    letter-spacing: -.04em;\n    text-wrap: balance;\n    color: var(--rn-paper) !important;\n    -webkit-text-fill-color: var(--rn-paper);\n  }\n\n  #recent-news-{{ section.id }} .rn-summary {\n    max-width: 34ch;\n    margin: 22px 0 0;\n    color: rgba(242, 240, 234, .72);\n    font: 400 14px/1.5 var(--font-body-family, Arial, sans-serif);\n    -webkit-text-fill-color: rgba(242, 240, 234, .72);\n  }\n\n  #recent-news-{{ section.id }} .rn-date {\n    writing-mode: vertical-rl;\n    color: rgba(242, 240, 234, .7);\n    font: 500 11px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  #recent-news-{{ section.id }} .rn-arrow {\n    display: inline-block;\n    margin-top: 26px;\n    font-size: 26px;\n    line-height: 1;\n    transition: transform 300ms ease;\n  }\n\n  @media (hover: hover) {\n    #recent-news-{{ section.id }} .rn-card:hover .rn-image {\n      filter: brightness(1.06);\n      transform: scale(1.045);\n    }\n\n    #recent-news-{{ section.id }} .rn-card:hover .rn-arrow,\n    #recent-news-{{ section.id }} .rn-all:hover span {\n      transform: translateX(7px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #recent-news-{{ section.id }} .rn-title {\n      font-size: clamp(64px, 13vw, 116px);\n    }\n\n    #recent-news-{{ section.id }} .rn-content {\n      min-height: 190px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #recent-news-{{ section.id }} .rn-shell {\n      padding: 72px 0 88px;\n    }\n\n    #recent-news-{{ section.id }} .rn-header {\n      grid-template-columns: 1fr;\n      padding: 0 20px;\n      margin-bottom: 52px;\n    }\n\n    #recent-news-{{ section.id }} .rn-title {\n      max-width: none;\n      font-size: clamp(60px, 21vw, 96px);\n    }\n\n    #recent-news-{{ section.id }} .rn-all {\n      width: fit-content;\n    }\n\n    #recent-news-{{ section.id }} .rn-grid {\n      display: flex;\n      padding: 0 20px;\n      overflow-x: auto;\n      border: 0;\n      scroll-padding-left: 20px;\n      scroll-snap-type: x mandatory;\n      scrollbar-width: none;\n    }\n\n    #recent-news-{{ section.id }} .rn-grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    #recent-news-{{ section.id }} .rn-card {\n      width: min(82vw, 360px);\n      padding: 14px;\n      flex: 0 0 auto;\n      border: 1px solid var(--rn-line);\n      scroll-snap-align: start;\n    }\n\n    #recent-news-{{ section.id }} .rn-card + .rn-card {\n      margin-left: 12px;\n      border-left: 1px solid var(--rn-line);\n    }\n\n    #recent-news-{{ section.id }} .rn-content {\n      min-height: 180px;\n    }\n\n    #recent-news-{{ section.id }} .rn-card-title {\n      font-size: 34px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #recent-news-{{ section.id }} .rn-image,\n    #recent-news-{{ section.id }} .rn-arrow {\n      transition: none;\n    }\n  }\n</style>\n\n<section id=\"recent-news-{{ section.id }}\" aria-labelledby=\"rn-heading-{{ section.id }}\">\n  <div class=\"rn-shell\">\n    <header class=\"rn-header\">\n      <h2 id=\"rn-heading-{{ section.id }}\" class=\"rn-title\">Recent News</h2>\n      <a class=\"rn-all\" href=\"/blogs/news\">View all news <span aria-hidden=\"true\">→</span></a>\n    </header>\n\n    <div class=\"rn-grid\">\n      <a class=\"rn-card\" href=\"{{ news_link_1 }}\">\n        <div class=\"rn-media\">\n          <img class=\"rn-image\" src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/newa.jpg?v=1753866234\" alt=\"After-wine support\" width=\"1000\" height=\"750\" loading=\"lazy\">\n          <span class=\"rn-index\">01</span>\n        </div>\n        <div class=\"rn-content\">\n          <div>\n            <h3 class=\"rn-card-title\">After-Wine Support</h3>\n            <p class=\"rn-summary\">Thoughtful, end-to-end solutions designed for every moment after the bottle is opened.</p>\n            <span class=\"rn-arrow\" aria-hidden=\"true\">→</span>\n          </div>\n          <time class=\"rn-date\" datetime=\"2025-07-14\">14 Jul 2025</time>\n        </div>\n      </a>\n\n      <a class=\"rn-card\" href=\"{{ news_link_2 }}\">\n        <div class=\"rn-media\">\n          <img class=\"rn-image\" src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/newb.jpg?v=1753866249\" alt=\"The art of meaningful gifts\" width=\"1000\" height=\"750\" loading=\"lazy\">\n          <span class=\"rn-index\">02</span>\n        </div>\n        <div class=\"rn-content\">\n          <div>\n            <h3 class=\"rn-card-title\">The Art of Meaningful Gifts</h3>\n            <p class=\"rn-summary\">Why the most memorable gifts are chosen with story, place, and ritual in mind.</p>\n            <span class=\"rn-arrow\" aria-hidden=\"true\">→</span>\n          </div>\n          <time class=\"rn-date\" datetime=\"2025-07-14\">14 Jul 2025</time>\n        </div>\n      </a>\n\n      <a class=\"rn-card\" href=\"{{ news_link_3 }}\">\n        <div class=\"rn-media\">\n          <img class=\"rn-image\" src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/newc.jpg?v=1753866265\" alt=\"Tea traditions and functions\" width=\"1000\" height=\"750\" loading=\"lazy\">\n          <span class=\"rn-index\">03</span>\n        </div>\n        <div class=\"rn-content\">\n          <div>\n            <h3 class=\"rn-card-title\">Tea, Tradition &amp; Function</h3>\n            <p class=\"rn-summary\">A closer look at the quiet rituals that shape the way tea is shared and enjoyed.</p>\n            <span class=\"rn-arrow\" aria-hidden=\"true\">→</span>\n          </div>\n          <time class=\"rn-date\" datetime=\"2025-07-14\">14 Jul 2025</time>\n        </div>\n      </a>\n    </div>\n  </div>\n</section>"
      }
    },
    "custom_liquid_pWGgH8": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  Paste optional Shopify CDN portrait URLs between the quotation marks.\n  Blank URLs automatically display customer initials.\n{% endcomment %}\n{% assign portrait_1 = '' %}\n{% assign portrait_2 = '' %}\n{% assign portrait_3 = '' %}\n\n<style>\n  #editorial-reviews-{{ section.id }} {\n    --rv-bg: #f2f0ea;\n    --rv-ink: #171717;\n    --rv-muted: #6e6b64;\n    --rv-line: rgba(23, 23, 23, .24);\n    background: var(--rv-bg);\n    color: var(--rv-ink);\n  }\n\n  #editorial-reviews-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-shell {\n    width: min(100%, 1680px);\n    margin: 0 auto;\n    padding: clamp(86px, 11vw, 180px) clamp(24px, 4vw, 72px);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(240px, .42fr);\n    gap: 50px;\n    margin-bottom: clamp(64px, 9vw, 140px);\n    align-items: end;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-title {\n    max-width: 8ch;\n    margin: 0;\n    color: var(--rv-ink) !important;\n    -webkit-text-fill-color: var(--rv-ink);\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(68px, 11vw, 180px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .82;\n    letter-spacing: -.07em;\n    text-transform: uppercase;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-intro {\n    max-width: 420px;\n    margin: 0 0 4px auto;\n    color: var(--rv-ink) !important;\n    font: 400 clamp(14px, 1.05vw, 17px)/1.55 var(--font-body-family, Arial, sans-serif);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-kicker {\n    display: block;\n    margin-bottom: 16px;\n    font-size: 11px;\n    font-weight: 600;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    border-top: 1px solid var(--rv-line);\n    border-bottom: 1px solid var(--rv-line);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-card {\n    display: flex;\n    min-width: 0;\n    min-height: 550px;\n    padding: clamp(32px, 3.2vw, 58px);\n    flex-direction: column;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-card + .rv-card {\n    border-left: 1px solid var(--rv-line);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-card-top {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 24px;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-portrait,\n  #editorial-reviews-{{ section.id }} .rv-initials {\n    display: grid;\n    width: clamp(82px, 8vw, 130px);\n    height: clamp(82px, 8vw, 130px);\n    flex: 0 0 auto;\n    place-items: center;\n    border-radius: 50%;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-portrait {\n    object-fit: cover;\n    filter: grayscale(100%);\n    transition: filter 350ms ease, transform 500ms cubic-bezier(.22, 1, .36, 1);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-initials {\n    border: 1px solid var(--rv-ink);\n    background: transparent;\n    color: var(--rv-ink);\n    font: 400 clamp(24px, 3vw, 44px)/1 var(--font-heading-family, Arial, sans-serif);\n    letter-spacing: -.04em;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-number {\n    color: var(--rv-muted);\n    font: 500 11px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .12em;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-quote-mark {\n    margin: clamp(46px, 6vw, 86px) 0 0;\n    color: var(--rv-ink);\n    font-family: Georgia, serif;\n    font-size: 74px;\n    line-height: .45;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-quote {\n    max-width: 29ch;\n    margin: 24px 0 46px;\n    color: var(--rv-ink) !important;\n    -webkit-text-fill-color: var(--rv-ink);\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(23px, 2.15vw, 38px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: 1.15;\n    letter-spacing: -.035em;\n    text-wrap: balance;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-footer {\n    display: flex;\n    margin-top: auto;\n    padding-top: 22px;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 20px;\n    border-top: 1px solid var(--rv-line);\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-person {\n    margin: 0;\n    color: var(--rv-ink) !important;\n    font: 600 12px/1.45 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .07em;\n    text-transform: uppercase;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-source {\n    display: block;\n    margin-top: 7px;\n    color: var(--rv-muted);\n    font-weight: 500;\n  }\n\n  #editorial-reviews-{{ section.id }} .rv-stars {\n    color: var(--rv-ink);\n    font: 400 15px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .06em;\n    white-space: nowrap;\n  }\n\n  @media (hover: hover) {\n    #editorial-reviews-{{ section.id }} .rv-card:hover .rv-portrait {\n      filter: grayscale(0%);\n      transform: scale(1.04);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #editorial-reviews-{{ section.id }} .rv-header {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-intro {\n      margin-left: 0;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-grid {\n      grid-template-columns: 1fr;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-card {\n      min-height: 0;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-card + .rv-card {\n      border-top: 1px solid var(--rv-line);\n      border-left: 0;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-quote {\n      max-width: 34ch;\n    }\n  }\n\n  @media screen and (max-width: 599px) {\n    #editorial-reviews-{{ section.id }} .rv-shell {\n      padding: 72px 18px;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-title {\n      font-size: clamp(62px, 21vw, 94px);\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-card {\n      padding: 34px 4px 38px;\n    }\n\n    #editorial-reviews-{{ section.id }} .rv-quote {\n      font-size: 28px;\n    }\n  }\n</style>\n\n<section id=\"editorial-reviews-{{ section.id }}\" aria-labelledby=\"rv-heading-{{ section.id }}\">\n  <div class=\"rv-shell\">\n    <header class=\"rv-header\">\n      <h2 id=\"rv-heading-{{ section.id }}\" class=\"rv-title\">Our Reviews</h2>\n      <p class=\"rv-intro\"><span class=\"rv-kicker\">From our community</span>Notes from customers discovering new flavors, places, and stories through every bottle.</p>\n    </header>\n\n    <div class=\"rv-grid\">\n      <article class=\"rv-card\">\n        <div class=\"rv-card-top\">\n          {% if portrait_1 != blank %}\n            <img class=\"rv-portrait\" src=\"{{ portrait_1 }}\" alt=\"Sophia L.\" width=\"260\" height=\"260\" loading=\"lazy\">\n          {% else %}\n            <span class=\"rv-initials\" aria-hidden=\"true\">SL</span>\n          {% endif %}\n          <span class=\"rv-number\">01</span>\n        </div>\n        <div class=\"rv-quote-mark\" aria-hidden=\"true\">“</div>\n        <blockquote class=\"rv-quote\">This wine surprised me—elegant, smooth, and with a depth I didn’t expect from a Chinese vineyard.</blockquote>\n        <footer class=\"rv-footer\">\n          <p class=\"rv-person\">Sophia L., Los Angeles<span class=\"rv-source\">TikTok</span></p>\n          <span class=\"rv-stars\" aria-label=\"5 out of 5 stars\">★★★★★</span>\n        </footer>\n      </article>\n\n      <article class=\"rv-card\">\n        <div class=\"rv-card-top\">\n          {% if portrait_2 != blank %}\n            <img class=\"rv-portrait\" src=\"{{ portrait_2 }}\" alt=\"Michael R.\" width=\"260\" height=\"260\" loading=\"lazy\">\n          {% else %}\n            <span class=\"rv-initials\" aria-hidden=\"true\">MR</span>\n          {% endif %}\n          <span class=\"rv-number\">02</span>\n        </div>\n        <div class=\"rv-quote-mark\" aria-hidden=\"true\">“</div>\n        <blockquote class=\"rv-quote\">I brought a TasteEast bottle to a dinner party. When I said China, everyone was stunned—in the best way.</blockquote>\n        <footer class=\"rv-footer\">\n          <p class=\"rv-person\">Michael R., San Francisco<span class=\"rv-source\">Instagram</span></p>\n          <span class=\"rv-stars\" aria-label=\"5 out of 5 stars\">★★★★★</span>\n        </footer>\n      </article>\n\n      <article class=\"rv-card\">\n        <div class=\"rv-card-top\">\n          {% if portrait_3 != blank %}\n            <img class=\"rv-portrait\" src=\"{{ portrait_3 }}\" alt=\"Elena T.\" width=\"260\" height=\"260\" loading=\"lazy\">\n          {% else %}\n            <span class=\"rv-initials\" aria-hidden=\"true\">ET</span>\n          {% endif %}\n          <span class=\"rv-number\">03</span>\n        </div>\n        <div class=\"rv-quote-mark\" aria-hidden=\"true\">“</div>\n        <blockquote class=\"rv-quote\">There’s a quiet confidence in these wines. You can taste the care, the craft, and something deeper.</blockquote>\n        <footer class=\"rv-footer\">\n          <p class=\"rv-person\">Elena T., Singapore<span class=\"rv-source\">Facebook</span></p>\n          <span class=\"rv-stars\" aria-label=\"5 out of 5 stars\">★★★★★</span>\n        </footer>\n      </article>\n    </div>\n  </div>\n</section>"
      }
    },
    "custom_liquid_MNYxWD": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% assign map_image = 'https://cdn.shopify.com/s/files/1/0751/1883/7988/files/map.jpg?v=1753865897' %}\n{% assign newsletter_form_id = 'NewsletterMap-' | append: section.id %}\n\n<style>\n  #newsletter-map-{{ section.id }} {\n    --nm-bg: #08182c;\n    --nm-cream: #efd2ad;\n    --nm-white: #f6f4ee;\n    --nm-line: rgba(246, 244, 238, .34);\n    background: var(--nm-bg);\n    color: var(--nm-white);\n  }\n\n  #newsletter-map-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #newsletter-map-{{ section.id }} .visually-hidden {\n    position: absolute !important;\n    width: 1px !important;\n    height: 1px !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n    clip: rect(0, 0, 0, 0) !important;\n    white-space: nowrap !important;\n    border: 0 !important;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-shell {\n    width: min(100%, 1680px);\n    margin: 0 auto;\n    padding: clamp(84px, 10vw, 170px) clamp(24px, 5vw, 88px);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-grid {\n    display: grid;\n    grid-template-columns: minmax(0, .82fr) minmax(420px, 1fr);\n    gap: clamp(64px, 9vw, 150px);\n    align-items: stretch;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-copy {\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-kicker {\n    margin: 0 0 26px;\n    color: var(--nm-white) !important;\n    font: 600 11px/1.2 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-title {\n    max-width: 9ch;\n    margin: 0;\n    color: var(--nm-cream) !important;\n    -webkit-text-fill-color: var(--nm-cream);\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(62px, 7.2vw, 122px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .88;\n    letter-spacing: -.065em;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-description {\n    max-width: 520px;\n    margin: 34px 0 0;\n    color: rgba(246, 244, 238, .78) !important;\n    -webkit-text-fill-color: rgba(246, 244, 238, .78);\n    font: 400 clamp(15px, 1.2vw, 19px)/1.55 var(--font-body-family, Arial, sans-serif);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-form {\n    max-width: 620px;\n    margin-top: clamp(64px, 8vw, 120px);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-fields {\n    display: grid;\n    grid-template-columns: minmax(0, .7fr) minmax(0, 1fr) auto;\n    border-top: 1px solid var(--nm-line);\n    border-bottom: 1px solid var(--nm-line);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-input {\n    width: 100%;\n    min-width: 0;\n    height: 72px;\n    margin: 0;\n    padding: 0 20px;\n    border: 0;\n    border-right: 1px solid var(--nm-line);\n    border-radius: 0;\n    outline: 0;\n    background: transparent;\n    box-shadow: none;\n    color: var(--nm-white) !important;\n    -webkit-text-fill-color: var(--nm-white);\n    font: 500 13px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .04em;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-input::placeholder {\n    opacity: 1;\n    color: rgba(246, 244, 238, .56);\n    -webkit-text-fill-color: rgba(246, 244, 238, .56);\n    text-transform: uppercase;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-input:focus {\n    background: rgba(255, 255, 255, .05);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-button {\n    min-width: 128px;\n    height: 72px;\n    padding: 0 24px;\n    border: 0;\n    border-radius: 0;\n    background: var(--nm-cream);\n    color: #11151d !important;\n    cursor: pointer;\n    font: 700 12px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    transition: background-color 250ms ease, color 250ms ease;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-button:hover {\n    background: var(--nm-white);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-legal {\n    max-width: 570px;\n    margin: 16px 0 0;\n    color: rgba(246, 244, 238, .46) !important;\n    font: 400 11px/1.5 var(--font-body-family, Arial, sans-serif);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-message {\n    margin: 18px 0 0;\n    color: var(--nm-white) !important;\n    font: 500 13px/1.5 var(--font-body-family, Arial, sans-serif);\n  }\n\n  #newsletter-map-{{ section.id }} .nm-message--success {\n    color: var(--nm-cream) !important;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-message ul {\n    margin: 0;\n    padding-left: 18px;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-visual {\n    position: relative;\n    display: flex;\n    min-height: 0;\n    overflow: hidden;\n    align-items: center;\n    justify-content: center;\n    background: #ecebea;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-map {\n    display: block;\n    width: 100%;\n    height: auto;\n    object-fit: contain;\n    object-position: center;\n    transition: opacity 300ms ease;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-map-label {\n    position: absolute;\n    right: 22px;\n    bottom: 22px;\n    display: flex;\n    padding: 11px 15px;\n    align-items: center;\n    gap: 12px;\n    background: var(--nm-bg);\n    color: var(--nm-white);\n    font: 600 10px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .12em;\n    text-transform: uppercase;\n  }\n\n  #newsletter-map-{{ section.id }} .nm-map-label::before {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--nm-cream);\n    content: '';\n  }\n\n  @media (hover: hover) {\n    #newsletter-map-{{ section.id }} .nm-visual:hover .nm-map {\n      opacity: .96;\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #newsletter-map-{{ section.id }} .nm-grid {\n      grid-template-columns: 1fr;\n      gap: 72px;\n    }\n\n    #newsletter-map-{{ section.id }} .nm-title {\n      max-width: 11ch;\n      font-size: clamp(62px, 12vw, 108px);\n    }\n\n    #newsletter-map-{{ section.id }} .nm-visual {\n      min-height: 0;\n      aspect-ratio: auto;\n    }\n  }\n\n  @media screen and (max-width: 649px) {\n    #newsletter-map-{{ section.id }} .nm-shell {\n      padding: 72px 18px;\n    }\n\n    #newsletter-map-{{ section.id }} .nm-title {\n      font-size: clamp(55px, 17vw, 78px);\n    }\n\n    #newsletter-map-{{ section.id }} .nm-fields {\n      grid-template-columns: 1fr;\n      border-bottom: 0;\n    }\n\n    #newsletter-map-{{ section.id }} .nm-input {\n      height: 64px;\n      border-right: 0;\n      border-bottom: 1px solid var(--nm-line);\n    }\n\n    #newsletter-map-{{ section.id }} .nm-button {\n      width: 100%;\n      height: 64px;\n      margin-top: 14px;\n    }\n\n    #newsletter-map-{{ section.id }} .nm-visual {\n      aspect-ratio: auto;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #newsletter-map-{{ section.id }} .nm-map,\n    #newsletter-map-{{ section.id }} .nm-button {\n      transition: none;\n    }\n  }\n</style>\n\n<section id=\"newsletter-map-{{ section.id }}\" aria-labelledby=\"nm-title-{{ section.id }}\">\n  <div class=\"nm-shell\">\n    <div class=\"nm-grid\">\n      <div class=\"nm-copy\">\n        <div>\n          <p class=\"nm-kicker\">TasteEast newsletter</p>\n          <h2 id=\"nm-title-{{ section.id }}\" class=\"nm-title\">Stay in the know. Sip with style.</h2>\n          <p class=\"nm-description\">Be the first to explore limited releases, tasting notes, cultural stories, and considered gift ideas.</p>\n        </div>\n\n        {% form 'customer', id: newsletter_form_id, class: 'nm-form' %}\n          <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n\n          <div class=\"nm-fields\">\n            <label class=\"visually-hidden\" for=\"NewsletterName-{{ section.id }}\">Your name</label>\n            <input\n              id=\"NewsletterName-{{ section.id }}\"\n              class=\"nm-input\"\n              type=\"text\"\n              name=\"contact[first_name]\"\n              autocomplete=\"given-name\"\n              placeholder=\"Your name\"\n            >\n\n            <label class=\"visually-hidden\" for=\"NewsletterEmail-{{ section.id }}\">Your email address</label>\n            <input\n              id=\"NewsletterEmail-{{ section.id }}\"\n              class=\"nm-input\"\n              type=\"email\"\n              name=\"contact[email]\"\n              value=\"{% if form.email %}{{ form.email }}{% endif %}\"\n              autocorrect=\"off\"\n              autocapitalize=\"off\"\n              autocomplete=\"email\"\n              placeholder=\"Your email address\"\n              aria-required=\"true\"\n              required\n            >\n\n            <button class=\"nm-button\" type=\"submit\">Join us</button>\n          </div>\n\n          {% if form.posted_successfully? %}\n            <p class=\"nm-message nm-message--success\" tabindex=\"-1\">Thank you for joining us. Please check your inbox.</p>\n          {% endif %}\n\n          {% if form.errors %}\n            <div class=\"nm-message\" role=\"alert\">{{ form.errors | default_errors }}</div>\n          {% endif %}\n\n          <p class=\"nm-legal\">By signing up, you agree to receive marketing emails. You can unsubscribe at any time.</p>\n        {% endform %}\n      </div>\n\n      <div class=\"nm-visual\">\n        <img\n          class=\"nm-map\"\n          src=\"{{ map_image }}\"\n          alt=\"Map showing the connection between China and California\"\n          width=\"1400\"\n          height=\"1100\"\n          loading=\"lazy\"\n        >\n        <span class=\"nm-map-label\">China — California</span>\n      </div>\n    </div>\n  </div>\n</section>"
      }
    },
