        "custom_liquid": "{% assign story_image = 'https://cdn.shopify.com/s/files/1/0751/1883/7988/files/IMG_5176.jpg?v=1779917371' %}\n{% assign button_link = '/collections/all' %}\n\n<style>\n  #wine-story-{{ section.id }} {\n    --story-navy: #07182e;\n    --story-cream: #efd3b2;\n    --story-white: #f7f5f0;\n    width: 100%;\n    overflow: hidden;\n    background: var(--story-navy);\n  }\n\n  #wine-story-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #wine-story-{{ section.id }} .wine-story__grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n    min-height: clamp(680px, 53vw, 960px);\n  }\n\n  #wine-story-{{ section.id }} .wine-story__media {\n    position: relative;\n    min-height: 100%;\n    overflow: hidden;\n    background: #142214;\n  }\n\n  #wine-story-{{ section.id }} .wine-story__media::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(0, 0, 0, .08), rgba(0, 0, 0, .18));\n    content: '';\n    pointer-events: none;\n  }\n\n  #wine-story-{{ section.id }} .wine-story__image {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center center;\n    transition: transform 1.1s cubic-bezier(.22, 1, .36, 1);\n  }\n\n  #wine-story-{{ section.id }} .wine-story__content {\n    display: flex;\n    padding: clamp(64px, 7vw, 128px) clamp(44px, 6.5vw, 120px);\n    flex-direction: column;\n    justify-content: center;\n    background: var(--story-navy);\n    color: var(--story-white);\n  }\n\n  #wine-story-{{ section.id }} .wine-story__intro {\n    max-width: 690px;\n    margin: 0;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: clamp(15px, 1.25vw, 23px);\n    font-weight: 500;\n    line-height: 1.7;\n    letter-spacing: .025em;\n    text-transform: uppercase;\n  }\n\n  #wine-story-{{ section.id }} .wine-story__title {\n    max-width: 720px;\n    margin: clamp(76px, 10vw, 170px) 0 0;\n    color: var(--story-cream);\n    font-family: var(--font-heading-family, Georgia, serif);\n    font-size: clamp(56px, 6vw, 108px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .98;\n    letter-spacing: -.045em;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  #wine-story-{{ section.id }} .wine-story__button {\n    display: inline-flex;\n    width: fit-content;\n    min-height: 72px;\n    margin-top: clamp(52px, 6vw, 90px);\n    padding: 20px 54px;\n    align-items: center;\n    justify-content: center;\n    border: 1px solid var(--story-cream);\n    border-radius: 20px;\n    background: var(--story-cream);\n    color: #11151d;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: clamp(15px, 1.2vw, 20px);\n    font-weight: 700;\n    line-height: 1;\n    letter-spacing: .02em;\n    text-decoration: none;\n    text-transform: uppercase;\n    transition: background-color 250ms ease, color 250ms ease, transform 250ms ease;\n  }\n\n  @media (hover: hover) {\n    #wine-story-{{ section.id }}:hover .wine-story__image {\n      transform: scale(1.025);\n    }\n\n    #wine-story-{{ section.id }} .wine-story__button:hover {\n      background: transparent;\n      color: var(--story-cream);\n      transform: translateY(-3px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #wine-story-{{ section.id }} .wine-story__grid {\n      min-height: 660px;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__content {\n      padding: 58px 38px;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__title {\n      margin-top: 64px;\n      font-size: clamp(46px, 6.8vw, 70px);\n    }\n\n    #wine-story-{{ section.id }} .wine-story__button {\n      min-height: 62px;\n      margin-top: 48px;\n      padding: 18px 36px;\n      border-radius: 16px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #wine-story-{{ section.id }} .wine-story__grid {\n      display: flex;\n      min-height: 0;\n      flex-direction: column;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__media {\n      min-height: 0;\n      aspect-ratio: 4 / 5;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__image {\n      object-position: center center;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__content {\n      padding: 48px 24px 56px;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__intro {\n      font-size: 14px;\n      line-height: 1.65;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__title {\n      margin-top: 52px;\n      font-size: clamp(44px, 15vw, 68px);\n      line-height: 1;\n    }\n\n    #wine-story-{{ section.id }} .wine-story__button {\n      width: 100%;\n      min-height: 60px;\n      margin-top: 42px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #wine-story-{{ section.id }} .wine-story__image,\n    #wine-story-{{ section.id }} .wine-story__button {\n      transition: none;\n    }\n  }\n</style>\n\n<section id=\"wine-story-{{ section.id }}\" aria-labelledby=\"wine-story-title-{{ section.id }}\">\n  <div class=\"wine-story__grid\">\n    <div class=\"wine-story__media\">\n      <img\n        class=\"wine-story__image\"\n        src=\"{{ story_image }}\"\n        alt=\"Wine grapes growing on the vine\"\n        width=\"1400\"\n        height=\"1600\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"wine-story__content\">\n      <p class=\"wine-story__intro\">\n        From the heart of China to the coasts of California, each bottle carries the quiet fragrance of a land long overlooked — now ready to be celebrated.\n      </p>\n\n      <h2 id=\"wine-story-title-{{ section.id }}\" class=\"wine-story__title\">\n        From China to California\n      </h2>\n\n      <a class=\"wine-story__button\" href=\"{{ button_link }}\">\n        Discover more\n      </a>\n    </div>\n  </div>\n</section>"
