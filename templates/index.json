    "custom_liquid_Beckch": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "{% comment %}\n  Edit the four collection handles below so they match your Shopify collections.\n{% endcomment %}\n{% assign category_handles = 'wine|food|beverage|gift-collection' | split: '|' %}\n{% assign category_titles = 'WINE|FOOD|BEVERAGE|GIFT COLLECTION' | split: '|' %}\n\n<style>\n  #product-categories-{{ section.id }} {\n    --pc-bg: #f2f0ea;\n    --pc-text: #171717;\n    --pc-line: rgba(23, 23, 23, .22);\n    background: var(--pc-bg);\n    color: var(--pc-text);\n  }\n\n  #product-categories-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #product-categories-{{ section.id }} .pc-shell {\n    width: min(100%, 1680px);\n    margin: 0 auto;\n    padding: clamp(80px, 10vw, 170px) clamp(24px, 4vw, 72px);\n  }\n\n  #product-categories-{{ section.id }} .pc-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) minmax(280px, .55fr);\n    gap: 48px;\n    margin-bottom: clamp(56px, 7vw, 110px);\n    align-items: end;\n  }\n\n  #product-categories-{{ section.id }} .pc-title {\n    margin: 0;\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(62px, 10vw, 168px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .82;\n    letter-spacing: -.065em;\n    text-transform: uppercase;\n  }\n\n  #product-categories-{{ section.id }} .pc-intro {\n    max-width: 440px;\n    margin: 0 0 5px auto;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: clamp(14px, 1.05vw, 17px);\n    line-height: 1.55;\n    letter-spacing: .01em;\n  }\n\n  #product-categories-{{ section.id }} .pc-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    border-top: 1px solid var(--pc-line);\n    border-bottom: 1px solid var(--pc-line);\n  }\n\n  #product-categories-{{ section.id }} .pc-card {\n    position: relative;\n    display: flex;\n    min-width: 0;\n    padding: 18px;\n    flex-direction: column;\n    color: inherit;\n    text-decoration: none;\n  }\n\n  #product-categories-{{ section.id }} .pc-card + .pc-card {\n    border-left: 1px solid var(--pc-line);\n  }\n\n  #product-categories-{{ section.id }} .pc-media {\n    position: relative;\n    aspect-ratio: 4 / 5;\n    overflow: hidden;\n    background: #d8d5cc;\n  }\n\n  #product-categories-{{ section.id }} .pc-image,\n  #product-categories-{{ section.id }} .pc-placeholder {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 700ms cubic-bezier(.22, 1, .36, 1);\n  }\n\n  #product-categories-{{ section.id }} .pc-media::after {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, transparent 48%, rgba(0, 0, 0, .42));\n    content: '';\n    pointer-events: none;\n  }\n\n  #product-categories-{{ section.id }} .pc-number {\n    position: absolute;\n    z-index: 1;\n    top: 22px;\n    left: 22px;\n    color: #fff;\n    font: 500 11px/1 var(--font-body-family, Arial, sans-serif);\n    letter-spacing: .12em;\n  }\n\n  #product-categories-{{ section.id }} .pc-name {\n    position: absolute;\n    z-index: 1;\n    right: 22px;\n    bottom: 22px;\n    left: 22px;\n    margin: 0;\n    color: #fff;\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(25px, 2.3vw, 42px);\n    font-style: var(--font-heading-style, normal);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .95;\n    letter-spacing: -.035em;\n    text-transform: uppercase;\n    text-wrap: balance;\n  }\n\n  #product-categories-{{ section.id }} .pc-meta {\n    display: flex;\n    min-height: 72px;\n    padding: 20px 2px 4px;\n    align-items: flex-start;\n    justify-content: space-between;\n    gap: 16px;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  #product-categories-{{ section.id }} .pc-arrow {\n    font-size: 22px;\n    font-weight: 400;\n    line-height: .7;\n    transition: transform 300ms ease;\n  }\n\n  @media (hover: hover) {\n    #product-categories-{{ section.id }} .pc-card:hover .pc-image,\n    #product-categories-{{ section.id }} .pc-card:hover .pc-placeholder {\n      transform: scale(1.045);\n    }\n\n    #product-categories-{{ section.id }} .pc-card:hover .pc-arrow {\n      transform: translateX(7px);\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    #product-categories-{{ section.id }} .pc-header {\n      grid-template-columns: 1fr;\n      gap: 28px;\n    }\n\n    #product-categories-{{ section.id }} .pc-intro {\n      margin-left: 0;\n    }\n\n    #product-categories-{{ section.id }} .pc-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    #product-categories-{{ section.id }} .pc-card:nth-child(3) {\n      border-left: 0;\n    }\n\n    #product-categories-{{ section.id }} .pc-card:nth-child(n + 3) {\n      border-top: 1px solid var(--pc-line);\n    }\n  }\n\n  @media screen and (max-width: 599px) {\n    #product-categories-{{ section.id }} .pc-shell {\n      padding: 72px 18px;\n    }\n\n    #product-categories-{{ section.id }} .pc-title {\n      font-size: clamp(56px, 22vw, 92px);\n    }\n\n    #product-categories-{{ section.id }} .pc-grid {\n      grid-template-columns: 1fr;\n    }\n\n    #product-categories-{{ section.id }} .pc-card {\n      padding: 14px 0;\n      border-top: 1px solid var(--pc-line);\n      border-left: 0 !important;\n    }\n\n    #product-categories-{{ section.id }} .pc-card:first-child {\n      border-top: 0;\n    }\n\n    #product-categories-{{ section.id }} .pc-media {\n      aspect-ratio: 5 / 6;\n    }\n\n    #product-categories-{{ section.id }} .pc-name {\n      font-size: clamp(36px, 12vw, 54px);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #product-categories-{{ section.id }} .pc-image,\n    #product-categories-{{ section.id }} .pc-placeholder,\n    #product-categories-{{ section.id }} .pc-arrow {\n      transition: none;\n    }\n  }\n</style>\n\n<section id=\"product-categories-{{ section.id }}\" aria-labelledby=\"pc-title-{{ section.id }}\">\n  <div class=\"pc-shell\">\n    <header class=\"pc-header\">\n      <h2 id=\"pc-title-{{ section.id }}\" class=\"pc-title\">Products</h2>\n      <p class=\"pc-intro\">\n        Explore a considered collection of wines, foods, beverages, and gifts selected to bring cultures and stories together.\n      </p>\n    </header>\n\n    <div class=\"pc-grid\">\n      {% for category_handle in category_handles %}\n        {% assign category = collections[category_handle] %}\n        {% assign category_image = category.image %}\n        {% if category_image == blank and category.products.first.featured_image != blank %}\n          {% assign category_image = category.products.first.featured_image %}\n        {% endif %}\n\n        {% if category != blank %}\n          {% assign category_link = category.url %}\n        {% else %}\n          {% assign category_link = routes.all_products_collection_url %}\n        {% endif %}\n\n        <a class=\"pc-card\" href=\"{{ category_link }}\" aria-label=\"Shop {{ category_titles[forloop.index0] | escape }}\">\n          <div class=\"pc-media\">\n            {% if category_image != blank %}\n              {{ category_image\n                | image_url: width: 1000\n                | image_tag:\n                  class: 'pc-image',\n                  loading: 'lazy',\n                  widths: '360, 540, 720, 900, 1000',\n                  sizes: '(max-width: 599px) 100vw, (max-width: 989px) 50vw, 25vw',\n                  alt: category_titles[forloop.index0]\n              }}\n            {% else %}\n              {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'pc-placeholder' }}\n            {% endif %}\n\n            <span class=\"pc-number\">0{{ forloop.index }}</span>\n            <h3 class=\"pc-name\">{{ category_titles[forloop.index0] }}</h3>\n          </div>\n\n          <div class=\"pc-meta\">\n            <span>View collection</span>\n            <span class=\"pc-arrow\" aria-hidden=\"true\">→</span>\n          </div>\n        </a>\n      {% endfor %}\n    </div>\n  </div>\n</section>"
      }
    },
