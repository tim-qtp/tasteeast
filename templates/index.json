        "custom_liquid": "<style>\n  #sq-features-{{ section.id }} {\n    --sq-bg: #f2f0ea;\n    --sq-text: #171717;\n    --sq-line: #bebbb2;\n    background: var(--sq-bg);\n    color: var(--sq-text);\n  }\n\n  #sq-features-{{ section.id }} * {\n    box-sizing: border-box;\n  }\n\n  #sq-features-{{ section.id }} .sq-features__inner {\n    width: min(100%, 1600px);\n    margin: 0 auto;\n    padding: 80px clamp(24px, 4vw, 72px);\n  }\n\n  #sq-features-{{ section.id }} .sq-features__grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    border-top: 1px solid var(--sq-line);\n    border-bottom: 1px solid var(--sq-line);\n  }\n\n  #sq-features-{{ section.id }} .sq-features__card {\n    display: flex;\n    min-width: 0;\n    min-height: 440px;\n    padding: clamp(38px, 5vw, 76px) clamp(24px, 3.4vw, 58px);\n    flex-direction: column;\n    justify-content: space-between;\n    color: inherit;\n    text-decoration: none;\n  }\n\n  #sq-features-{{ section.id }} .sq-features__card + .sq-features__card {\n    border-left: 1px solid var(--sq-line);\n  }\n\n  #sq-features-{{ section.id }} .sq-features__icon {\n    display: block;\n    width: 72px;\n    height: 72px;\n    object-fit: contain;\n    object-position: left center;\n    transition: transform 350ms cubic-bezier(.22, 1, .36, 1);\n  }\n\n  #sq-features-{{ section.id }} .sq-features__content {\n    margin-top: clamp(72px, 9vw, 150px);\n  }\n\n  #sq-features-{{ section.id }} .sq-features__label {\n    margin: 0 0 16px;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: 11px;\n    font-weight: 500;\n    line-height: 1.2;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n  }\n\n  #sq-features-{{ section.id }} .sq-features__title {\n    max-width: 12ch;\n    margin: 0;\n    font-family: var(--font-heading-family, Arial, sans-serif);\n    font-size: clamp(30px, 3.15vw, 58px);\n    font-weight: var(--font-heading-weight, 400);\n    line-height: .98;\n    letter-spacing: -.045em;\n  }\n\n  #sq-features-{{ section.id }} .sq-features__text {\n    max-width: 34ch;\n    margin: 24px 0 0;\n    font-family: var(--font-body-family, Arial, sans-serif);\n    font-size: clamp(14px, 1.05vw, 17px);\n    line-height: 1.55;\n    letter-spacing: .01em;\n  }\n\n  @media (hover: hover) {\n    #sq-features-{{ section.id }} .sq-features__card:hover .sq-features__icon {\n      transform: translateY(-6px);\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    #sq-features-{{ section.id }} .sq-features__inner {\n      padding: 48px 20px;\n    }\n\n    #sq-features-{{ section.id }} .sq-features__grid {\n      grid-template-columns: 1fr;\n    }\n\n    #sq-features-{{ section.id }} .sq-features__card {\n      min-height: auto;\n      padding: 38px 4px 44px;\n    }\n\n    #sq-features-{{ section.id }} .sq-features__card + .sq-features__card {\n      border-top: 1px solid var(--sq-line);\n      border-left: 0;\n    }\n\n    #sq-features-{{ section.id }} .sq-features__content {\n      margin-top: 64px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #sq-features-{{ section.id }} .sq-features__icon {\n      transition: none;\n    }\n  }\n</style>\n\n<section id=\"sq-features-{{ section.id }}\" aria-label=\"Featured collections\">\n  <div class=\"sq-features__inner\">\n    <div class=\"sq-features__grid\">\n      <div class=\"sq-features__card\">\n        <img\n          class=\"sq-features__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/lefta.svg?v=1753866290\"\n          alt=\"\"\n          width=\"72\"\n          height=\"72\"\n          loading=\"lazy\"\n        >\n        <div class=\"sq-features__content\">\n          <p class=\"sq-features__label\">Discover</p>\n          <h2 class=\"sq-features__title\">Boutique Wines</h2>\n          <p class=\"sq-features__text\">Each bottle tells a story — of land, labor, and legacy.</p>\n        </div>\n      </div>\n\n      <div class=\"sq-features__card\">\n        <img\n          class=\"sq-features__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/centerb.svg?v=1753866305\"\n          alt=\"\"\n          width=\"72\"\n          height=\"72\"\n          loading=\"lazy\"\n        >\n        <div class=\"sq-features__content\">\n          <p class=\"sq-features__label\">Discover</p>\n          <h2 class=\"sq-features__title\">Eastern Delights</h2>\n          <p class=\"sq-features__text\">From delicate pastries to seasonal treasures — crafted to honor flavor and form.</p>\n        </div>\n      </div>\n\n      <div class=\"sq-features__card\">\n        <img\n          class=\"sq-features__icon\"\n          src=\"https://cdn.shopify.com/s/files/1/0751/1883/7988/files/rightc.svg?v=1753866319\"\n          alt=\"\"\n          width=\"72\"\n          height=\"72\"\n          loading=\"lazy\"\n        >\n        <div class=\"sq-features__content\">\n          <p class=\"sq-features__label\">Discover</p>\n          <h2 class=\"sq-features__title\">Gift Collections</h2>\n          <p class=\"sq-features__text\">Inspired by Eastern rituals of giving — refined, personal, unforgettable.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>"
      }
