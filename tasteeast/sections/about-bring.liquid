<section style="
  background-image: url('https://cdn.shopify.com/s/files/1/0714/2408/2105/files/value_8c901aee-8e7d-466e-adff-702652761243.jpg?v=1753537383');
  background-size: cover;
  background-position: center;
  color: #fff;
  padding: 80px 20px 60px;
  background-color: #E6E2D8;
  background-repeat: no-repeat;
" data-aos="fade-up">
  <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
    <p style="font-size: 14px; margin-bottom: 12px;">{{ section.settings.subheading }}</p>
    <h2 style="font-size: 54px; font-family: 'Limelight', serif; font-weight: bold; color: #f5d5a2; margin-bottom: 40px;">
      {{ section.settings.heading }}
    </h2>
  </div>
</section>

<section style="background-color: #E6E2D8; padding: 60px 20px 0;">
  <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; text-align: left;">
    {% for block in section.blocks %}
      <div style="flex: 1 1 30%; min-width: 280px;" data-aos="zoom-in" data-aos-delay="{{ forloop.index0 | times: 100 }}">
        <img src="{{ block.settings.image | image_url }}" alt="" style="width: 100%; height: auto; margin-bottom: 20px;" />
        <div style="font-size: 14px; line-height: 1.6; color: #000; margin-bottom: 40px;">
          {{ block.settings.text }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "About Bring Block",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Rooted in heritage, guided by quality,"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "BRINGING THE BEST OF CHINA TO THE HEART OF AMERICA"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (if needed)"
    }
  ],
  "blocks": [
    {
      "type": "image_text_block",
      "name": "Image + Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Paragraph Text",
          "default": "Text here..."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Bring Block",
      "category": "Custom",
      "blocks": [
        {
          "type": "image_text_block"
        },
        {
          "type": "image_text_block"
        },
        {
          "type": "image_text_block"
        }
      ]
    }
  ]
}
{% endschema %}
