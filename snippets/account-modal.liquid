<div id="accountModal" class="account-modal" aria-hidden="true">
  <div class="account-modal__backdrop" onclick="closeAccountModal()"></div>

  <div class="account-modal__panel" role="dialog" aria-modal="true" aria-labelledby="accountModalTitle">
    <button type="button" class="account-modal__close" aria-label="Close" onclick="closeAccountModal()">×</button>

    <!-- LOGIN -->
    <div class="account-modal__view" data-view="login">
      <h2 id="accountModalTitle" class="account-modal__title">Login</h2>

      {% form 'customer_login', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <label class="account-modal__label" for="CustomerEmail">Email</label>
          <input
            id="CustomerEmail"
            class="account-modal__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <div class="account-modal__field">
          <label class="account-modal__label" for="CustomerPassword">Password</label>
          <input
            id="CustomerPassword"
            class="account-modal__input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            placeholder="Password"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Sign in</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('recover'); return false;">Forgot password?</a>
          <span class="account-modal__sep">·</span>
          <a href="{{ routes.account_register_url }}">Create account</a>
        </div>
      {% endform %}
    </div>

    <!-- RECOVER -->
    <div class="account-modal__view" data-view="recover" hidden>
      <h2 class="account-modal__title">Reset password</h2>

      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <div class="account-modal__success" role="status">
            We&#39;ve sent you an email with a link to update your password.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <label class="account-modal__label" for="RecoverEmail">Email</label>
          <input
            id="RecoverEmail"
            class="account-modal__input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Send reset link</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('login'); return false;">Back to login</a>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
  /* Modal 容器 */
  .account-modal { position: fixed; inset: 0; display: none; z-index: 9999; }
  .account-modal.is-open { display: block; }
  .account-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
  .account-modal__panel {
    position: relative;
    width: min(520px, calc(100% - 40px));
    margin: 10vh auto 0;
    background: #fff;
    padding: 24px;
    box-shadow: 0 18px 40px rgba(0,0,0,.12);
  }

  .account-modal__close {
    position: absolute; top: 10px; right: 12px;
    border: 0; background: transparent; font-size: 24px; line-height: 1; cursor: pointer;
  }

  .account-modal__title { margin: 0 0 16px; font-size: 22px; font-weight: 600; }
  .account-modal__field { margin-bottom: 14px; }

  /* ✅ 按你要求：不需要上方重复提示（隐藏 label，只保留 placeholder 暗文） */
  .account-modal__label { display: none !important; }

  /* ✅ 按你要求：输入框无圆角、统一风格 */
  .account-modal__input {
    width: 100%;
    border: 1px solid #D6D6D6;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 12px 12px;
    background: #fff;
    color: #222;
  }
  .account-modal__input:focus { outline: none; border-color: #216D81; }

  .account-modal__btn {
    width: 100%;
    border: 1px solid #222;
    border-radius: 0 !important;
    padding: 12px 12px;
    cursor: pointer;
    background: #222;
    color: #fff;
    margin-top: 6px;
  }

  .account-modal__links { margin-top: 12px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .account-modal__links a { text-decoration: underline; }
  .account-modal__sep { opacity: .6; }

  .account-modal__error { margin: 10px 0; padding: 10px; border: 1px solid #d33; }
  .account-modal__success { margin: 10px 0; padding: 10px; border: 1px solid #2a7; }
</style>
