<div id="accountModal" class="account-modal" aria-hidden="true">
  <div class="account-modal__backdrop" onclick="closeAccountModal()"></div>

  <div class="account-modal__panel" role="dialog" aria-modal="true" aria-labelledby="accountModalTitle">
    <button type="button" class="account-modal__close" aria-label="Close" onclick="closeAccountModal()">×</button>

    <!-- LOGIN -->
    <div class="account-modal__view" data-view="login">
      <h2 id="accountModalTitle" class="account-modal__title">Login</h2>

      {% form 'customer_login', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <!-- ✅ 不显示上方提示，只用 placeholder（暗文） -->
          <label class="account-modal__label" for="CustomerEmail">Email</label>
          <input
            id="CustomerEmail"
            class="account-modal__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <div class="account-modal__field">
          <!-- ✅ 不显示上方提示，只用 placeholder（暗文） -->
          <label class="account-modal__label" for="CustomerPassword">Password</label>
          <input
            id="CustomerPassword"
            class="account-modal__input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            placeholder="Password"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Sign in</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('recover'); return false;">Forgot password?</a>
          <a href="{{ routes.account_register_url }}">Create account</a>
        </div>
      {% endform %}
    </div>

    <!-- RECOVER -->
    <div class="account-modal__view" data-view="recover" hidden>
      <h2 class="account-modal__title">Reset password</h2>

      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <div class="account-modal__success" role="status">
            We&#39;ve sent you an email with a link to update your password.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <!-- ✅ 不显示上方提示，只用 placeholder（暗文） -->
          <label class="account-modal__label" for="RecoverEmail">Email</label>
          <input
            id="RecoverEmail"
            class="account-modal__input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Send reset link</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('login'); return false;">Back to login</a>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
/* =========================
   Minimal / Premium modal
   ========================= */
.account-modal { position: fixed; inset: 0; display: none; z-index: 9999; }
.account-modal.is-open { display: block; }

.account-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.35); }

.account-modal__panel {
  position: relative;
  width: 420px;
  max-width: calc(100% - 40px);
  margin: 12vh auto 0;
  background: #fff;
  padding: 32px 28px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.12);
}

/* close */
.account-modal__close {
  position: absolute;
  top: 16px;
  right: 16px;
  border: 0;
  background: transparent;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  opacity: .6;
}
.account-modal__close:hover { opacity: 1; }

.account-modal__title {
  margin: 0 0 18px;
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.01em;
}

/* field */
.account-modal__field { margin-bottom: 14px; }

/* ✅ 核心：隐藏上方提示(label)，只留 placeholder 暗文 */
.account-modal__label { display: none !important; }

.account-modal__input {
  width: 100%;
  border: 1px solid #d6d6d6;
  border-radius: 0 !important;   /* ✅ 统一无圆角 */
  padding: 12px 12px;
  font-size: 14px;
  box-shadow: none !important;
  background: #fff;
  color: #111;
}
.account-modal__input:focus {
  outline: none;
  border-color: #000;
}

.account-modal__btn {
  width: 100%;
  margin-top: 10px;
  padding: 12px;
  border: 1px solid #000;
  border-radius: 0 !important;   /* ✅ 统一无圆角 */
  background: #000;
  color: #fff;
  font-size: 14px;
  cursor: pointer;
}
.account-modal__btn:hover { opacity: .9; }

.account-modal__links {
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  gap: 16px;
  font-size: 13px;
}
.account-modal__links a { color: #000; text-decoration: underline; }

.account-modal__error,
.account-modal__success {
  margin: 0 0 12px;
  padding: 10px;
  font-size: 13px;
  border: 1px solid #ddd;
}
</style>
