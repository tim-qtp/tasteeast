<div id="accountModal" class="account-modal" aria-hidden="true">
  <div class="account-modal__backdrop" onclick="closeAccountModal()"></div>

  <div class="account-modal__panel" role="dialog" aria-modal="true" aria-labelledby="accountModalTitle">
    <button type="button" class="account-modal__close" aria-label="Close" onclick="closeAccountModal()">×</button>

    <!-- LOGIN -->
    <div class="account-modal__view" data-view="login">
      <h2 id="accountModalTitle" class="account-modal__title">Login</h2>

      {% form 'customer_login', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <label class="account-modal__label" for="CustomerEmail">Email</label>
          <input
            id="CustomerEmail"
            class="account-modal__input"
            type="email"
            name="customer[email]"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <div class="account-modal__field">
          <label class="account-modal__label" for="CustomerPassword">Password</label>
          <input
            id="CustomerPassword"
            class="account-modal__input"
            type="password"
            name="customer[password]"
            autocomplete="current-password"
            placeholder="Password"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Sign in</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('recover'); return false;">Forgot password?</a>
          <span class="account-modal__sep">·</span>
          <a href="{{ routes.account_register_url }}">Create account</a>
        </div>
      {% endform %}
    </div>

    <!-- RECOVER -->
    <div class="account-modal__view" data-view="recover" hidden>
      <h2 class="account-modal__title">Reset password</h2>

      {% form 'recover_customer_password' %}
        {% if form.posted_successfully? %}
          <div class="account-modal__success" role="status">
            We&#39;ve sent you an email with a link to update your password.
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="account-modal__error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="account-modal__field">
          <label class="account-modal__label" for="RecoverEmail">Email</label>
          <input
            id="RecoverEmail"
            class="account-modal__input"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email"
            required
          >
        </div>

        <button type="submit" class="account-modal__btn">Send reset link</button>

        <div class="account-modal__links">
          <a href="#" onclick="switchAccountModal('login'); return false;">Back to login</a>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
/* =========================
   Minimal Account Modal
   ========================= */

.account-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
}

.account-modal.is-open {
  display: block;
}

/* 半透明背景 */
.account-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
}

/* 弹窗主体 */
.account-modal__panel {
  position: relative;
  width: 420px;
  max-width: calc(100% - 40px);
  margin: 12vh auto 0;
  background: #fff;
  padding: 32px 28px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.12);
}

/* 关闭按钮（极简） */
.account-modal__close {
  position: absolute;
  top: 16px;
  right: 16px;
  border: none;
  background: none;
  font-size: 20px;
  line-height: 1;
  cursor: pointer;
  opacity: 0.6;
}
.account-modal__close:hover {
  opacity: 1;
}

/* 标题 */
.account-modal__title {
  margin: 0 0 20px;
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.01em;
}

/* 表单字段 */
.account-modal__field {
  margin-bottom: 14px;
}

/* ✅ 不显示 label，只用 placeholder */
.account-modal__label {
  display: none !important;
}

/* 输入框：细线 + 无圆角 */
.account-modal__input {
  width: 100%;
  border: 1px solid #d6d6d6;
  border-radius: 0;
  padding: 12px 12px;
  font-size: 14px;
  box-shadow: none;
  background: #fff;
}

.account-modal__input:focus {
  outline: none;
  border-color: #000;
}

/* 登录按钮：纯黑块 */
.account-modal__btn {
  width: 100%;
  margin-top: 12px;
  padding: 12px;
  border: none;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-size: 14px;
  cursor: pointer;
}

.account-modal__btn:hover {
  opacity: 0.9;
}

/* 底部链接 */
.account-modal__links {
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  font-size: 13px;
}

.account-modal__links a {
  text-decoration: underline;
  color: #000;
}

/* 错误 & 成功信息 */
.account-modal__error,
.account-modal__success {
  margin-bottom: 12px;
  font-size: 13px;
  padding: 10px;
  border: 1px solid #ddd;
}
</style>

